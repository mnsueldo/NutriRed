@model NutriRed.Web.Models.ReportesIndexViewModel
@{
    ViewData["Title"] = "Módulo de Reportes";
}

<style>
    .nav-tabs-custom .nav-link {
        color: #6c757d;
        font-weight: 600;
        border: none;
        border-bottom: 3px solid transparent;
        padding: 0.75rem 1.25rem;
        transition: all 0.2s ease;
    }

    .nav-tabs-custom .nav-link:hover {
        color: #198754;
        border-color: transparent;
    }

    .nav-tabs-custom .nav-link.active {
        color: #198754;
        background-color: transparent;
        border-bottom: 3px solid #198754;
    }

    body.dark-mode .nav-tabs-custom .nav-link {
        color: #94a3b8;
    }

    body.dark-mode .nav-tabs-custom .nav-link:hover,
    body.dark-mode .nav-tabs-custom .nav-link.active {
        color: #34d399;
        border-bottom-color: #34d399;
    }

    body.high-contrast .nav-tabs-custom .nav-link {
        color: #ffffff;
    }

    body.high-contrast .nav-tabs-custom .nav-link.active {
        color: #00ff66;
        border-bottom: 3px solid #00ff66;
    }

    .filter-card {
        background-color: #ffffff;
        border: 1px solid rgba(0, 0, 0, 0.08);
    }

    body.dark-mode .filter-card {
        background-color: #1e293b !important;
        border: 1px solid #334155 !important;
        color: #f8fafc !important;
    }

    body.high-contrast .filter-card {
        background-color: #000000 !important;
        border: 2px solid #ffffff !important;
        color: #ffffff !important;
    }

    .btn-export-pdf {
        background-color: #6f42c1;
        color: #ffffff;
    }

    .btn-export-pdf:hover {
        background-color: #5c35a5;
        color: #ffffff;
    }

    body.dark-mode .table-responsive {
        border-color: #334155 !important;
    }

    body.high-contrast .table-responsive {
        border-color: #ffffff !important;
    }

    /* Badges semánticos por estado FEFO */
    .badge-fefo-optimo {
        background-color: rgba(25, 135, 84, 0.15);
        color: #198754;
        border: 1px solid rgba(25, 135, 84, 0.3);
    }
    body.dark-mode .badge-fefo-optimo {
        background-color: rgba(52, 211, 153, 0.2) !important;
        color: #34d399 !important;
        border-color: #34d399 !important;
    }
    body.high-contrast .badge-fefo-optimo {
        background-color: #000000 !important;
        color: #00ff66 !important;
        border: 2px solid #00ff66 !important;
    }

    .badge-fefo-atencion {
        background-color: rgba(255, 193, 7, 0.15);
        color: #997404;
        border: 1px solid rgba(255, 193, 7, 0.4);
    }
    body.dark-mode .badge-fefo-atencion {
        background-color: rgba(251, 191, 36, 0.2) !important;
        color: #fbbf24 !important;
        border-color: #fbbf24 !important;
    }
    body.high-contrast .badge-fefo-atencion {
        background-color: #000000 !important;
        color: #ffff00 !important;
        border: 2px solid #ffff00 !important;
    }

    .badge-fefo-urgente {
        background-color: rgba(253, 126, 20, 0.15);
        color: #d65b00;
        border: 1px solid rgba(253, 126, 20, 0.4);
    }
    body.dark-mode .badge-fefo-urgente {
        background-color: rgba(251, 146, 60, 0.2) !important;
        color: #fb923c !important;
        border-color: #fb923c !important;
    }
    body.high-contrast .badge-fefo-urgente {
        background-color: #000000 !important;
        color: #ff9900 !important;
        border: 2px solid #ff9900 !important;
    }

    .badge-fefo-vencido {
        background-color: rgba(220, 53, 69, 0.15);
        color: #dc3545;
        border: 1px solid rgba(220, 53, 69, 0.4);
    }
    body.dark-mode .badge-fefo-vencido {
        background-color: rgba(248, 113, 113, 0.2) !important;
        color: #f87171 !important;
        border-color: #f87171 !important;
    }
    body.high-contrast .badge-fefo-vencido {
        background-color: #000000 !important;
        color: #ff4d4d !important;
        border: 2px solid #ff4d4d !important;
    }

    .badge-fefo-sinstock {
        background-color: rgba(108, 117, 125, 0.15);
        color: #6c757d;
        border: 1px solid rgba(108, 117, 125, 0.3);
    }
    body.dark-mode .badge-fefo-sinstock {
        background-color: rgba(148, 163, 184, 0.2) !important;
        color: #94a3b8 !important;
        border-color: #64748b !important;
    }
    body.high-contrast .badge-fefo-sinstock {
        background-color: #000000 !important;
        color: #ffffff !important;
        border: 2px solid #ffffff !important;
    }
</style>

<!-- Encabezado de la Página -->
<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h2 class="fw-bold text-dark mb-1 d-flex align-items-center gap-2">
            <span class="bg-success bg-opacity-10 text-success p-2 rounded-3 d-inline-flex align-items-center justify-content-center" style="width: 42px; height: 42px;">
                <i class="bi bi-file-earmark-bar-graph-fill fs-4"></i>
            </span>
            Reportes
        </h2>
        <p class="text-muted mb-0 small ms-1">Generá y descargá reportes consolidados del sistema.</p>
    </div>
</div>

<!-- Menú de Pestañas (Tabs) -->
<ul class="nav nav-tabs nav-tabs-custom border-bottom mb-4">
    <li class="nav-item">
        <a class="nav-link @(Model.TabActiva == "inventario" ? "active" : "")" asp-action="Index" asp-route-tab="inventario">
            <i class="bi bi-box-seam me-1"></i>Inventario
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(Model.TabActiva == "donaciones" ? "active" : "")" asp-action="Index" asp-route-tab="donaciones">
            <i class="bi bi-gift me-1"></i>Donaciones
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(Model.TabActiva == "entregas" ? "active" : "")" asp-action="Index" asp-route-tab="entregas">
            <i class="bi bi-truck me-1"></i>Entregas
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(Model.TabActiva == "familias" ? "active" : "")" asp-action="Index" asp-route-tab="familias">
            <i class="bi bi-people me-1"></i>Familias
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(Model.TabActiva == "trazabilidad" ? "active" : "")" asp-action="Index" asp-route-tab="trazabilidad">
            <i class="bi bi-diagram-3 me-1"></i>Trazabilidad
        </a>
    </li>
</ul>

<!-- Panel de Filtros unificados -->
<form method="get" asp-action="Index" class="card border-0 shadow-sm rounded-4 p-4 mb-4 filter-card">
    <input type="hidden" name="tab" value="@Model.TabActiva" />

    <div class="row g-3 align-items-end">
        @if (Model.TabActiva == "inventario")
        {
            <div class="col-12 col-md-3 col-lg-3">
                <label class="form-label small fw-semibold text-secondary mb-1">Buscar alimento o código</label>
                <input type="text" name="busquedaInventario" value="@Model.BusquedaInventario" class="form-control rounded-3" placeholder="Nombre o EAN..." />
            </div>
            <div class="col-12 col-md-3 col-lg-3">
                <label class="form-label small fw-semibold text-secondary mb-1">Categoría</label>
                <select name="categoriaId" class="form-select rounded-3">
                    <option value="">Todas las categorías</option>
                    @foreach (var cat in Model.Categorias)
                    {
                        <option value="@cat.Value" selected="@(cat.Value == Model.CategoriaId?.ToString())">@cat.Text</option>
                    }
                </select>
            </div>
            <div class="col-12 col-md-3 col-lg-3">
                <label class="form-label small fw-semibold text-secondary mb-1">Estado Stock</label>
                <select name="estadoStock" class="form-select rounded-3">
                    <option value="">Todos</option>
                    <option value="Con stock suficiente" selected="@(Model.EstadoStock == "Con stock suficiente")">Con stock suficiente</option>
                    <option value="Bajo stock mínimo" selected="@(Model.EstadoStock == "Bajo stock mínimo")">Bajo stock mínimo</option>
                    <option value="Agotado / Sin stock" selected="@(Model.EstadoStock == "Agotado / Sin stock")">Agotado / Sin stock</option>
                </select>
            </div>
            <div class="col-12 col-md-3 col-lg-3">
                <label class="form-label small fw-semibold text-secondary mb-1">Semáforo de Vencimiento</label>
                <select name="semaforoFefo" class="form-select rounded-3">
                    <option value="">Todos los estados FEFO</option>
                    <option value="Óptimo (> 15 días)" selected="@(Model.SemaforoFefo == "Óptimo (> 15 días)")">Óptimo (&gt; 15 días)</option>
                    <option value="Atención (<= 15 días)" selected="@(Model.SemaforoFefo == "Atención (<= 15 días)")">Atención (&le; 15 días)</option>
                    <option value="Urgente (<= 5 días)" selected="@(Model.SemaforoFefo == "Urgente (<= 5 días)")">Urgente (&le; 5 días)</option>
                    <option value="Crítico / Vencido" selected="@(Model.SemaforoFefo == "Crítico / Vencido")">Crítico / Vencido</option>
                </select>
            </div>
        }
        else
        {
            <div class="col-12 col-md-3 col-lg-3">
                <label class="form-label small fw-semibold text-secondary mb-1">Fecha Desde</label>
                <input type="date" name="fechaDesde" value="@(Model.FechaDesde?.ToString("yyyy-MM-dd"))" class="form-control rounded-3" />
            </div>
            <div class="col-12 col-md-3 col-lg-3">
                <label class="form-label small fw-semibold text-secondary mb-1">Fecha Hasta</label>
                <input type="date" name="fechaHasta" value="@(Model.FechaHasta?.ToString("yyyy-MM-dd"))" class="form-control rounded-3" />
            </div>

            @if (Model.TabActiva == "donaciones")
            {
                <div class="col-12 col-md-3 col-lg-3">
                    <label class="form-label small fw-semibold text-secondary mb-1">Donante</label>
                    <select name="donanteId" class="form-select rounded-3">
                        <option value="">Todos los Donantes</option>
                        @foreach (var d in Model.Donantes)
                        {
                            <option value="@d.Value" selected="@(d.Value == Model.DonanteId?.ToString())">@d.Text</option>
                        }
                    </select>
                </div>
            }
            else if (Model.TabActiva == "entregas")
            {
                <div class="col-12 col-md-3 col-lg-3">
                    <label class="form-label small fw-semibold text-secondary mb-1">Tipo de Kit</label>
                    <select name="tipoPaqueteId" class="form-select rounded-3">
                        <option value="">Todos los Kits</option>
                        @foreach (var t in Model.TiposPaquete)
                        {
                            <option value="@t.Value" selected="@(t.Value == Model.TipoPaqueteId?.ToString())">@t.Text</option>
                        }
                    </select>
                </div>
            }
            else if (Model.TabActiva == "familias" || Model.TabActiva == "trazabilidad")
            {
                <div class="col-12 col-md-4 col-lg-4">
                    <label class="form-label small fw-semibold text-secondary mb-1">Búsqueda avanzada</label>
                    <input type="text" name="busqueda" value="@Model.Busqueda" class="form-control rounded-3" placeholder="Apellido, DNI o PKG..." />
                </div>
            }
        }

        <div class="col-12 col-md-4 col-lg-2 ms-auto">
            <button type="submit" class="btn btn-success rounded-3 fw-semibold w-100 py-2 shadow-sm">
                <i class="bi bi-funnel-fill me-1"></i>Generar
            </button>
        </div>
    </div>
</form>

<!-- Tarjetas de Impacto / KPIs Superiores -->
<div class="row g-3 mb-4">
    <div class="col-12 col-md-4">
        <div class="card border-0 shadow-sm rounded-4 p-3 filter-card">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-circle bg-success bg-opacity-10 p-3 text-success d-flex align-items-center justify-content-center flex-shrink-0" style="width: 48px; height: 48px;">
                    <i class="bi bi-funnel-fill fs-5"></i>
                </div>
                <div>
                    <span class="text-muted small fw-semibold text-uppercase d-block">Registros Filtrados</span>
                    <span class="fs-4 fw-bold text-dark">@Model.TotalRegistros</span>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-4">
        <div class="card border-0 shadow-sm rounded-4 p-3 filter-card">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-circle bg-primary bg-opacity-10 p-3 text-primary d-flex align-items-center justify-content-center flex-shrink-0" style="width: 48px; height: 48px;">
                    <i class="bi bi-layers fs-5"></i>
                </div>
                <div>
                    <span class="text-muted small fw-semibold text-uppercase d-block">Paginación</span>
                    <span class="fs-4 fw-bold text-dark">Página @Model.PaginaActual de @(Model.TotalPaginas > 0 ? Model.TotalPaginas : 1)</span>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-4">
        <div class="card border-0 shadow-sm rounded-4 p-3 filter-card">
            <div class="d-flex align-items-center gap-3">
                @if (Model.TabActiva == "inventario")
                {
                    <div class="rounded-circle bg-info bg-opacity-10 p-3 text-info d-flex align-items-center justify-content-center flex-shrink-0" style="width: 48px; height: 48px;">
                        <i class="bi bi-box-seam-fill fs-5"></i>
                    </div>
                    <div>
                        <span class="text-muted small fw-semibold text-uppercase d-block">Stock en Página</span>
                        <span class="fs-4 fw-bold text-dark">@Model.ReporteInventario.Sum(i => i.StockDisponible).ToString("N1") <small class="fs-6 fw-normal text-muted">kg/u</small></span>
                    </div>
                }
                else if (Model.TabActiva == "donaciones")
                {
                    <div class="rounded-circle bg-primary bg-opacity-10 p-3 text-primary d-flex align-items-center justify-content-center flex-shrink-0" style="width: 48px; height: 48px;">
                        <i class="bi bi-gift-fill fs-5"></i>
                    </div>
                    <div>
                        <span class="text-muted small fw-semibold text-uppercase d-block">Volumen en Página</span>
                        <span class="fs-4 fw-bold text-dark">@Model.ReporteDonaciones.Sum(d => d.CantidadTotal).ToString("N1") <small class="fs-6 fw-normal text-muted">kg/u</small></span>
                    </div>
                }
                else if (Model.TabActiva == "entregas")
                {
                    <div class="rounded-circle bg-success bg-opacity-10 p-3 text-success d-flex align-items-center justify-content-center flex-shrink-0" style="width: 48px; height: 48px;">
                        <i class="bi bi-truck fs-5"></i>
                    </div>
                    <div>
                        <span class="text-muted small fw-semibold text-uppercase d-block">Alimentos en Página</span>
                        <span class="fs-4 fw-bold text-dark">@Model.ReporteEntregas.Sum(e => e.TotalAlimentos) <small class="fs-6 fw-normal text-muted">ítems</small></span>
                    </div>
                }
                else if (Model.TabActiva == "familias")
                {
                    <div class="rounded-circle bg-warning bg-opacity-10 p-3 text-warning-emphasis d-flex align-items-center justify-content-center flex-shrink-0" style="width: 48px; height: 48px;">
                        <i class="bi bi-people-fill fs-5 text-warning"></i>
                    </div>
                    <div>
                        <span class="text-muted small fw-semibold text-uppercase d-block">Personas en Página</span>
                        <span class="fs-4 fw-bold text-dark">@Model.ReporteFamilias.Sum(f => f.Integrantes) <small class="fs-6 fw-normal text-muted">pers.</small></span>
                    </div>
                }
                else
                {
                    <div class="rounded-circle bg-secondary bg-opacity-10 p-3 text-secondary d-flex align-items-center justify-content-center flex-shrink-0" style="width: 48px; height: 48px;">
                        <i class="bi bi-diagram-3-fill fs-5"></i>
                    </div>
                    <div>
                        <span class="text-muted small fw-semibold text-uppercase d-block">Trazas en Página</span>
                        <span class="fs-4 fw-bold text-dark">@Model.ReporteTrazabilidad.Count <small class="fs-6 fw-normal text-muted">filas</small></span>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Grilla y Exportación -->
<div class="row g-4">
    <div class="col-12 col-lg-8 col-xl-9">
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white filter-card h-100 d-flex flex-column justify-content-between">
            <div>
                <h5 class="fw-bold text-dark mb-3 text-capitalize">
                    <i class="bi bi-journal-text text-success me-2"></i>Reporte de @Model.TabActiva
                </h5>

                <div class="table-responsive rounded-3 border">
                    @if (Model.TabActiva == "inventario")
                    {
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light small text-secondary">
                                <tr>
                                    <th>Producto / EAN</th>
                                    <th>Lote & Vencimiento</th>
                                    <th>Ingreso</th>
                                    <th>Stock</th>
                                    <th>Estado</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.ReporteInventario)
                                {
                                    string badgeFefoClass = item.Estado switch
                                    {
                                        var s when s.Contains("Óptimo") || s.Contains("Optimo") => "badge-fefo-optimo",
                                        var s when s.Contains("Atención") || s.Contains("Atencion") => "badge-fefo-atencion",
                                        var s when s.Contains("Urgente") => "badge-fefo-urgente",
                                        var s when s.Contains("Crítico") || s.Contains("Critico") || s.Contains("Vencido") => "badge-fefo-vencido",
                                        _ => "badge-fefo-sinstock"
                                    };

                                    <tr>
                                        <td class="fw-medium">
                                            <div>@item.Producto</div>
                                            <small class="text-muted font-monospace">@item.CodigoEan</small>
                                        </td>
                                        <td>
                                            <div class="fw-bold font-monospace text-dark">@item.NumeroLote</div>
                                            @if (item.FechaVencimiento != DateTime.MinValue)
                                            {
                                                <small class="text-muted">Vence: @item.FechaVencimiento.ToString("dd/MM/yyyy")</small>
                                            }
                                        </td>
                                        <td><small>@(item.FechaIngreso != DateTime.MinValue ? item.FechaIngreso.ToString("dd/MM/yyyy") : "-")</small></td>
                                        <td class="fw-bold">@item.StockDisponible.ToString("G29") <small class="text-muted fw-normal">@item.UnidadMedida</small></td>
                                        <td><span class="badge @badgeFefoClass px-2.5 py-1.5 rounded-pill">@item.Estado</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else if (Model.TabActiva == "donaciones")
                    {
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light small text-secondary">
                                <tr>
                                    <th style="width: 22%;">Comprobante</th>
                                    <th style="width: 18%;">Fecha</th>
                                    <th style="width: 30%;">Donante</th>
                                    <th class="text-center" style="width: 10%;">Ítems</th>
                                    <th class="text-center" style="width: 10%;">Total Vol.</th>
                                    <th class="text-end pe-4" style="width: 10%;">Acción</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.ReporteDonaciones)
                                {
                                    <tr>
                                        <td class="fw-bold text-primary font-monospace">@item.Comprobante</td>
                                        <td class="small">@item.FechaHora.ToString("dd/MM/yyyy HH:mm")</td>
                                        <td>
                                            <div class="fw-medium text-dark">@item.Donante</div>
                                            <small class="text-muted font-monospace">Doc: @item.Documento</small>
                                        </td>
                                        <td class="text-center"><span class="badge bg-secondary-subtle text-body border px-2.5 py-1 rounded-pill">@item.CantidadItems ítems</span></td>
                                        <td class="text-center fw-bold font-monospace">@item.CantidadTotal.ToString("G29")</td>
                                        <td class="text-end pe-4">
                                            <a asp-controller="Donaciones" asp-action="Comprobante" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary rounded-pill px-2.5 py-1 fw-semibold shadow-sm">
                                                <i class="bi bi-receipt me-1"></i> Comprobante
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else if (Model.TabActiva == "entregas")
                    {
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light small text-secondary">
                                <tr>
                                    <th style="width: 22%;">Código PKG</th>
                                    <th style="width: 18%;">Fecha Entrega</th>
                                    <th style="width: 30%;">Familia</th>
                                    <th style="width: 16%;">Kit</th>
                                    <th class="text-end pe-4" style="width: 14%;">Acción</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.ReporteEntregas)
                                {
                                    <tr>
                                        <td class="fw-bold text-success font-monospace">@item.CodigoPaquete</td>
                                        <td class="small">@item.FechaEntrega.ToString("dd/MM/yyyy HH:mm")</td>
                                        <td>
                                            <div class="fw-medium text-dark">@item.Familia</div>
                                            <small class="text-muted">DNI: @item.DniTitular</small>
                                        </td>
                                        <td><span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2.5 py-1 rounded-pill">@item.TipoKit</span></td>
                                        <td class="text-end pe-4">
                                            <a asp-controller="Entregas" asp-action="Comprobante" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary rounded-pill px-2.5 py-1 fw-semibold shadow-sm">
                                                <i class="bi bi-receipt me-1"></i> Comprobante
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else if (Model.TabActiva == "familias")
                    {
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light small text-secondary">
                                <tr>
                                    <th>Familia</th>
                                    <th>DNI Titular</th>
                                    <th>Integrantes</th>
                                    <th>Kits Recibidos</th>
                                    <th>Última Entrega</th>
                                    <th>Estado</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.ReporteFamilias)
                                {
                                    <tr>
                                        <td class="fw-medium">@item.Familia</td>
                                        <td class="font-monospace small">@item.DniTitular</td>
                                        <td><span class="badge bg-secondary-subtle text-body border px-2.5 py-1 rounded-pill">@item.Integrantes pers.</span></td>
                                        <td class="fw-bold text-success">@item.TotalKitsRecibidos</td>
                                        <td class="small">@(item.UltimaEntrega.HasValue? item.UltimaEntrega.Value.ToString("dd/MM/yyyy") : "Sin entregas")</td>
                                        <td><span class="badge bg-success-subtle text-success border border-success-subtle px-2.5 py-1 rounded-pill">@item.Estado</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else if (Model.TabActiva == "trazabilidad")
                    {
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light small text-secondary">
                                <tr>
                                    <th>Paquete</th>
                                    <th>Alimento</th>
                                    <th>Lote</th>
                                    <th>Familia Receptora</th>
                                    <th>Fecha Entrega</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.ReporteTrazabilidad)
                                {
                                    <tr>
                                        <td class="fw-bold text-primary">@item.CodigoPaquete</td>
                                        <td class="fw-medium">@item.Alimento</td>
                                        <td><span class="badge bg-secondary-subtle text-body font-monospace border px-2.5 py-1 rounded-pill">@item.NumeroLote</span></td>
                                        <td>@item.FamiliaBeneficiaria</td>
                                        <td class="small">@item.FechaEntrega.ToString("dd/MM/yyyy")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>

            <!-- Paginación Global de 10 en 10 -->
            @if (Model.TotalPaginas > 1)
            {
                <nav class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top px-2">
                    <small class="text-muted">
                        Mostrando página <strong>@Model.PaginaActual</strong> de <strong>@Model.TotalPaginas</strong> (@Model.TotalRegistros registros)
                    </small>
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(Model.PaginaActual == 1 ? "disabled" : "")">
                            <a class="page-link rounded-start-3" asp-action="Index"
                               asp-route-tab="@Model.TabActiva"
                               asp-route-pagina="@(Model.PaginaActual - 1)"
                               asp-route-fechaDesde="@(Model.FechaDesde?.ToString("yyyy-MM-dd"))"
                               asp-route-fechaHasta="@(Model.FechaHasta?.ToString("yyyy-MM-dd"))"
                               asp-route-categoriaId="@Model.CategoriaId"
                               asp-route-busquedaInventario="@Model.BusquedaInventario"
                               asp-route-estadoStock="@Model.EstadoStock"
                               asp-route-semaforoFefo="@Model.SemaforoFefo"
                               asp-route-donanteId="@Model.DonanteId"
                               asp-route-tipoPaqueteId="@Model.TipoPaqueteId"
                               asp-route-voluntarioId="@Model.VoluntarioId"
                               asp-route-busqueda="@Model.Busqueda">Anterior</a>
                        </li>
                        @for (int i = 1; i <= Model.TotalPaginas; i++)
                        {
                            <li class="page-item @(Model.PaginaActual == i ? "active" : "")">
                                <a class="page-link" asp-action="Index"
                                   asp-route-tab="@Model.TabActiva"
                                   asp-route-pagina="@i"
                                   asp-route-fechaDesde="@(Model.FechaDesde?.ToString("yyyy-MM-dd"))"
                                   asp-route-fechaHasta="@(Model.FechaHasta?.ToString("yyyy-MM-dd"))"
                                   asp-route-categoriaId="@Model.CategoriaId"
                                   asp-route-busquedaInventario="@Model.BusquedaInventario"
                                   asp-route-estadoStock="@Model.EstadoStock"
                                   asp-route-semaforoFefo="@Model.SemaforoFefo"
                                   asp-route-donanteId="@Model.DonanteId"
                                   asp-route-tipoPaqueteId="@Model.TipoPaqueteId"
                                   asp-route-voluntarioId="@Model.VoluntarioId"
                                   asp-route-busqueda="@Model.Busqueda">@i</a>
                            </li>
                        }
                        <li class="page-item @(Model.PaginaActual == Model.TotalPaginas ? "disabled" : "")">
                            <a class="page-link rounded-end-3" asp-action="Index"
                               asp-route-tab="@Model.TabActiva"
                               asp-route-pagina="@(Model.PaginaActual + 1)"
                               asp-route-fechaDesde="@(Model.FechaDesde?.ToString("yyyy-MM-dd"))"
                               asp-route-fechaHasta="@(Model.FechaHasta?.ToString("yyyy-MM-dd"))"
                               asp-route-categoriaId="@Model.CategoriaId"
                               asp-route-busquedaInventario="@Model.BusquedaInventario"
                               asp-route-estadoStock="@Model.EstadoStock"
                               asp-route-semaforoFefo="@Model.SemaforoFefo"
                               asp-route-donanteId="@Model.DonanteId"
                               asp-route-tipoPaqueteId="@Model.TipoPaqueteId"
                               asp-route-voluntarioId="@Model.VoluntarioId"
                               asp-route-busqueda="@Model.Busqueda">Siguiente</a>
                        </li>
                    </ul>
                </nav>
            }
        </div>
    </div>

    <!-- Panel Lateral de Exportación Funcional -->
    <div class="col-12 col-lg-4 col-xl-3">
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white filter-card h-100 d-flex flex-column justify-content-between">
            <div>
                <h5 class="fw-bold text-dark mb-1 d-flex align-items-center gap-2">
                    <i class="bi bi-download text-success"></i>Exportar
                </h5>
                <p class="text-muted small mb-4">Descargá el reporte filtrado:</p>

                <div class="d-grid gap-3">
                    <a asp-action="Exportar" asp-route-formato="csv" asp-route-tab="@Model.TabActiva"
                       asp-route-fechaDesde="@(Model.FechaDesde?.ToString("yyyy-MM-dd"))" 
                       asp-route-fechaHasta="@(Model.FechaHasta?.ToString("yyyy-MM-dd"))"
                       asp-route-categoriaId="@Model.CategoriaId"
                       asp-route-busquedaInventario="@Model.BusquedaInventario"
                       asp-route-estadoStock="@Model.EstadoStock"
                       asp-route-semaforoFefo="@Model.SemaforoFefo"
                       asp-route-donanteId="@Model.DonanteId"
                       asp-route-tipoPaqueteId="@Model.TipoPaqueteId"
                       asp-route-voluntarioId="@Model.VoluntarioId"
                       asp-route-busqueda="@Model.Busqueda"
                       class="btn btn-success rounded-3 fw-semibold py-2.5 d-flex align-items-center justify-content-center gap-2 shadow-sm text-decoration-none">
                        <i class="bi bi-file-earmark-spreadsheet-fill fs-5"></i>Descargar CSV
                    </a>

                    <a asp-action="Exportar" asp-route-formato="pdf" asp-route-tab="@Model.TabActiva"
                       asp-route-fechaDesde="@(Model.FechaDesde?.ToString("yyyy-MM-dd"))" 
                       asp-route-fechaHasta="@(Model.FechaHasta?.ToString("yyyy-MM-dd"))"
                       asp-route-categoriaId="@Model.CategoriaId"
                       asp-route-busquedaInventario="@Model.BusquedaInventario"
                       asp-route-estadoStock="@Model.EstadoStock"
                       asp-route-semaforoFefo="@Model.SemaforoFefo"
                       asp-route-donanteId="@Model.DonanteId"
                       asp-route-tipoPaqueteId="@Model.TipoPaqueteId"
                       asp-route-voluntarioId="@Model.VoluntarioId"
                       asp-route-busqueda="@Model.Busqueda"
                       class="btn btn-export-pdf rounded-3 fw-semibold py-2.5 d-flex align-items-center justify-content-center gap-2 shadow-sm text-decoration-none">
                        <i class="bi bi-file-earmark-pdf-fill fs-5"></i>Descargar PDF
                    </a>
                </div>
            </div>

            <div class="mt-4 pt-3 border-top">
                <p class="text-muted small mb-0 d-flex align-items-start gap-2">
                    <i class="bi bi-info-circle text-primary mt-0.5"></i>
                    <span>Exporta exactamente los registros que coinciden con los filtros actuales.</span>
                </p>
            </div>
        </div>
    </div>
</div>

