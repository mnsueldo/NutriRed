@model NutriRed.Web.Models.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard - Control Center";
    var fechaActual = DateTime.Now.ToString("d 'de' MMMM 'de' yyyy", new System.Globalization.CultureInfo("es-ES"));

    // Cálculo de total y porcentajes para la leyenda FEFO
    var totalLotesFefo = Model.CantidadFefoOptimo + Model.CantidadFefoAtencion + Model.CantidadFefoUrgente + Model.CantidadFefoVencido;
    double CalcPorcentaje(int cantidad) => totalLotesFefo > 0 ? Math.Round((double)cantidad / totalLotesFefo * 100, 1) : 0;
}

<div class="container-fluid py-4">

    <!-- Encabezado Principal -->
    <div class="d-flex justify-content-between align-items-center border-bottom pb-3 mb-4">
        <div>
            <div class="d-flex align-items-center mb-2">
                <i class="bi bi-shield-check text-danger me-2 fs-5"></i>
                <span class="text-muted fw-semibold">NutriRed Control Center</span>
            </div>
            <h2 class="fw-bold text-dark mb-0">Métricas de Impacto - Tablero Visivo</h2>
            <p class="text-muted mb-0">Panel general de gestión e indicadores de rendimiento.</p>
        </div>

        <div class="d-flex flex-column align-items-end">
            <div class="text-muted small mb-2">
                <i class="bi bi-calendar3 me-1"></i> Hoy, @fechaActual
            </div>
        </div>
    </div>

    <!-- Pestañas Módulo / Navegación Principal -->
    <ul class="nav nav-pills mb-4 border-bottom pb-2">
        <li class="nav-item">
            <a class="nav-link active rounded-pill fw-semibold px-4 bg-danger" asp-controller="Dashboard" asp-action="Index">
                <i class="bi bi-grid-1x2-fill me-2"></i>Inicio (Dashboard)
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link rounded-pill fw-semibold px-4 text-muted" asp-controller="Trazabilidad" asp-action="Index">
                <i class="bi bi-diagram-3 me-2"></i>Trazabilidad
            </a>
        </li>
        @if (User.IsInRole("Administrador"))
        {
            <li class="nav-item">
                <a class="nav-link rounded-pill fw-semibold px-4 text-muted" asp-controller="Reportes" asp-action="Index">
                    <i class="bi bi-file-earmark-bar-graph me-2"></i>Reportes
                </a>
            </li>
        }
    </ul>

<style>
    .kpi-link-card {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        text-decoration: none;
        color: inherit;
        display: block;
    }
    .kpi-link-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.12) !important;
        color: inherit;
    }
    .kpi-link-card:focus-visible {
        outline: 2px solid var(--bs-primary);
        outline-offset: 3px;
    }
</style>

    <!-- Tarjetas de Resumen (KPIs Dinámicos Interactivos) -->
    <div class="row g-3 mb-4">

        <!-- KPI 1: Alimentos Distribuidos -->
        <div class="col-md-3">
            <a asp-controller="Entregas" asp-action="Index" asp-route-tab="historial" class="kpi-link-card h-100" title="Ver historial de entregas">
                <div class="card border border-success-subtle shadow-sm rounded-3 h-100">
                    <div class="card-body d-flex flex-column justify-content-between p-3">
                        <div class="d-flex align-items-center">
                            <div class="bg-success rounded-circle d-flex justify-content-center align-items-center text-white me-3 shadow-sm flex-shrink-0" style="width: 50px; height: 50px;">
                                <i class="bi bi-basket2-fill fs-4"></i>
                            </div>
                            <div class="flex-grow-1">
                                <span class="text-muted small fw-semibold">Alimentos Distribuidos</span>
                                <div class="d-flex align-items-baseline">
                                    <h4 class="fw-bold text-dark mb-0 me-2">
                                        @Model.AlimentosDistribuidosKg.ToString("N1") <small class="fs-6">kg/L/u</small>
                                    </h4>
                                </div>
                                <small class="text-muted d-block mt-1">Kilos de comida entregados</small>
                            </div>
                        </div>
                        <div class="text-end small text-success fw-semibold mt-2 pt-2 border-top border-success-subtle d-flex align-items-center justify-content-end gap-1">
                            <span>Ver despachos</span> <i class="bi bi-arrow-right"></i>
                        </div>
                    </div>
                </div>
            </a>
        </div>

        <!-- KPI 2: Familias Beneficiadas -->
        <div class="col-md-3">
            <a asp-controller="Familias" asp-action="Index" class="kpi-link-card h-100" title="Ver familias beneficiarias">
                <div class="card border border-primary-subtle shadow-sm rounded-3 h-100">
                    <div class="card-body d-flex flex-column justify-content-between p-3">
                        <div class="d-flex align-items-center">
                            <div class="bg-primary rounded-circle d-flex justify-content-center align-items-center text-white me-3 shadow-sm flex-shrink-0" style="width: 50px; height: 50px;">
                                <i class="bi bi-house-heart-fill fs-4"></i>
                            </div>
                            <div class="flex-grow-1">
                                <span class="text-muted small fw-semibold">Familias Beneficiadas</span>
                                <h4 class="fw-bold text-dark mb-0">@Model.FamiliasBeneficiariasActivas</h4>
                                <small class="text-muted d-block mt-1">Legajos en estado Activo</small>
                            </div>
                        </div>
                        <div class="text-end small text-primary fw-semibold mt-2 pt-2 border-top border-primary-subtle d-flex align-items-center justify-content-end gap-1">
                            <span>Ver legajos</span> <i class="bi bi-arrow-right"></i>
                        </div>
                    </div>
                </div>
            </a>
        </div>

        <!-- KPI 3: Total Productos en Stock -->
        <div class="col-md-3">
            <a asp-controller="Inventario" asp-action="Index" class="kpi-link-card h-100" title="Ver inventario consolidado">
                <div class="card border border-info-subtle shadow-sm rounded-3 h-100">
                    <div class="card-body d-flex flex-column justify-content-between p-3">
                        <div class="d-flex align-items-center">
                            <div class="bg-info rounded-circle d-flex justify-content-center align-items-center text-white me-3 shadow-sm flex-shrink-0" style="width: 50px; height: 50px;">
                                <i class="bi bi-box-seam-fill fs-4"></i>
                            </div>
                            <div class="flex-grow-1">
                                <span class="text-muted small fw-semibold">Productos en Stock</span>
                                <h4 class="fw-bold text-dark mb-0">
                                    @Model.TotalProductosStockKg.ToString("N2") <small class="fs-6 fw-normal">kg/L/u</small>
                                </h4>
                                <small class="text-muted d-block mt-1">Disponible en depósitos</small>
                            </div>
                        </div>
                        <div class="text-end small text-info fw-semibold mt-2 pt-2 border-top border-info-subtle d-flex align-items-center justify-content-end gap-1">
                            <span>Ver inventario</span> <i class="bi bi-arrow-right"></i>
                        </div>
                    </div>
                </div>
            </a>
        </div>

        <!-- KPI 4: Productos Merma/Baja -->
        <div class="col-md-3">
            <a asp-controller="Inventario" asp-action="RegistrarMerma" class="kpi-link-card h-100" title="Gestionar mermas y bajas de inventario">
                <div class="card border border-danger-subtle shadow-sm rounded-3 h-100">
                    <div class="card-body d-flex flex-column justify-content-between p-3">
                        <div class="d-flex align-items-center">
                            <div class="bg-danger rounded-circle d-flex justify-content-center align-items-center text-white me-3 shadow-sm flex-shrink-0" style="width: 50px; height: 50px;">
                                <i class="bi bi-trash3-fill fs-4"></i>
                            </div>
                            <div class="flex-grow-1">
                                <span class="text-muted small fw-semibold">Total Bajas Registradas</span>
                                <h4 class="fw-bold text-dark mb-0">
                                    @Model.ProductosMermaKg.ToString("N1") <small class="fs-6 fw-normal">kg/L/u</small>
                                </h4>
                                <small class="text-muted d-block mt-1">Vencido, deteriorado o rotura</small>
                            </div>
                        </div>
                        <div class="text-end small text-danger fw-semibold mt-2 pt-2 border-top border-danger-subtle d-flex align-items-center justify-content-end gap-1">
                            <span>Gestionar mermas</span> <i class="bi bi-arrow-right"></i>
                        </div>
                    </div>
                </div>
            </a>
        </div>

    </div>

    <!-- Sección Inferior: Gráficos e Indicadores FEFO -->
    <div class="row g-3">
        <!-- Gráfico: Distribución Mensual -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-header bg-transparent border-0 py-3 d-flex justify-content-between align-items-center">
                    <h6 class="fw-bold mb-0 text-dark">Distribución Mensual (Kgs)</h6>
                </div>
                <div class="card-body pt-0">
                    <canvas id="donacionesChart" style="min-height: 220px;"></canvas>
                </div>
            </div>
        </div>

        <!-- Estado FEFO con Datos Reales y Porcentajes -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-header bg-transparent border-0 py-3 d-flex justify-content-between align-items-center">
                    <h6 class="fw-bold mb-0 text-dark">Estado del Inventario (Semáforo FEFO)</h6>
                    <span class="badge bg-secondary-subtle text-body border">@totalLotesFefo Ítems</span>
                </div>
                <div class="card-body d-flex align-items-center">
                    <div class="row w-100 align-items-center">
                        <div class="col-6 text-center position-relative">
                            <canvas id="fefoChart"></canvas>
                        </div>
                        <div class="col-6">
                            <ul class="list-unstyled mb-0 small">
                                <li class="mb-2 d-flex justify-content-between align-items-center">
                                    <span><i class="bi bi-circle-fill text-success me-1"></i>Óptimo</span>
                                    <span class="fw-bold text-dark">@Model.CantidadFefoOptimo <small class="text-muted">(@CalcPorcentaje(Model.CantidadFefoOptimo)%)</small></span>
                                </li>
                                <li class="mb-2 d-flex justify-content-between align-items-center">
                                    <span><i class="bi bi-circle-fill text-warning me-1"></i>Atención</span>
                                    <span class="fw-bold text-dark">@Model.CantidadFefoAtencion <small class="text-muted">(@CalcPorcentaje(Model.CantidadFefoAtencion)%)</small></span>
                                </li>
                                <li class="mb-2 d-flex justify-content-between align-items-center">
                                    <span><i class="bi bi-circle-fill me-1" style="color: #fd7e14;"></i>Urgente</span>
                                    <span class="fw-bold text-dark">@Model.CantidadFefoUrgente <small class="text-muted">(@CalcPorcentaje(Model.CantidadFefoUrgente)%)</small></span>
                                </li>
                                <li class="d-flex justify-content-between align-items-center">
                                    <span><i class="bi bi-circle-fill text-danger me-1"></i>Vencido</span>
                                    <span class="fw-bold text-dark">@Model.CantidadFefoVencido <small class="text-muted">(@CalcPorcentaje(Model.CantidadFefoVencido)%)</small></span>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Alertas de Próximos Vencimientos FEFO -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-3 h-100 d-flex flex-column justify-content-between">
                <div>
                    <div class="card-header bg-danger text-white border-0 py-3 d-flex justify-content-between align-items-center rounded-top">
                        <h6 class="fw-bold mb-0"><i class="bi bi-exclamation-triangle-fill me-2"></i>Prevención de Desperdicio</h6>
                        <span class="badge bg-white text-danger rounded-pill">Prioridad FEFO</span>
                    </div>
                    <div class="card-body p-0">
                        @if (Model.LotesAlertas != null && Model.LotesAlertas.Any())
                        {
                            <div class="list-group list-group-flush small">
                                @foreach (var lote in Model.LotesAlertas.Take(3))
                                {
                                    <div class="list-group-item list-group-item-action d-flex justify-content-between align-items-center p-3">
                                        <div>
                                            <h6 class="mb-1 fw-bold text-dark">@lote.NombreProducto</h6>
                                            <p class="mb-0 text-muted font-monospace" style="font-size: 0.75rem;">
                                                Lote: @lote.CodigoLote | Disp: @lote.CantidadDisponible
                                            </p>
                                        </div>
                                        <div class="text-end">
                                            <span class="badge @(lote.DiasParaVencer <= 5 ? "bg-danger text-white" : "bg-warning-subtle text-warning-emphasis border border-warning-subtle") rounded-pill px-3 py-2">
                                                @(lote.DiasParaVencer <= 0 ? "Vencido" : $"Vence en {lote.DiasParaVencer} d")
                                            </span>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="p-4 text-center text-muted small">
                                <i class="bi bi-check-circle text-success fs-3 d-block mb-2"></i>
                                No hay lotes en riesgo inminente de vencimiento.
                            </div>
                        }
                    </div>
                </div>

                <div class="card-footer bg-transparent border-0 pt-2 pb-3 px-3 text-center">
                    @if (User.IsInRole("Administrador"))
                    {
                        <a asp-controller="Reportes" asp-action="Index" asp-route-tab="inventario" asp-route-semaforoFefo="Urgente (<= 5 días)" class="btn btn-sm btn-outline-danger rounded-pill px-3 fw-semibold w-100">
                            <i class="bi bi-shield-exclamation me-1"></i>Ver todos los lotes críticos en Reportes
                        </a>
                    }
                    else
                    {
                        <a asp-controller="Inventario" asp-action="Index" asp-route-diasAlerta="30" class="btn btn-sm btn-outline-danger rounded-pill px-3 fw-semibold w-100">
                            <i class="bi bi-box-seam me-1"></i>Ver stock crítico en Inventario
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {

            // Detección y paleta de colores reactiva al tema visual
            const getChartColors = () => {
                const isDark = document.body.classList.contains('dark-mode') || document.body.classList.contains('high-contrast');
                return {
                    ticks: isDark ? '#94a3b8' : '#6b7280',
                    grid: isDark ? 'rgba(255, 255, 255, 0.08)' : '#f3f4f6',
                    doughnutBorder: isDark ? '#1e293b' : '#ffffff'
                };
            };

            const colors = getChartColors();

            // 1. Serialización de listas desde el ViewModel hacia JavaScript
            const etiquetasMeses = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DistribucionMensualEtiquetas));
            const valoresKilos = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DistribucionMensualValores));

            // 2. Gráfico de Barras: Distribución Mensual
            const ctxDonaciones = document.getElementById('donacionesChart').getContext('2d');
            const donacionesChartInstance = new Chart(ctxDonaciones, {
                type: 'bar',
                data: {
                    labels: etiquetasMeses && etiquetasMeses.length > 0 ? etiquetasMeses : ['Sin datos'],
                    datasets: [{
                        label: 'Distribución (Kgs)',
                        data: valoresKilos && valoresKilos.length > 0 ? valoresKilos : [0],
                        backgroundColor: '#3b82f6',
                        borderRadius: 4
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    const value = context.parsed.y || 0;
                                    return ` Entregado: ${value.toLocaleString('es-AR', { minimumFractionDigits: 1, maximumFractionDigits: 1 })} kg`;
                                }
                            }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: { color: colors.ticks },
                            grid: { color: colors.grid, drawBorder: false }
                        },
                        x: {
                            ticks: { color: colors.ticks },
                            grid: { display: false, drawBorder: false }
                        }
                    }
                }
            });

            // 3. Gráfico de Torta / Dona FEFO con datos reales del Modelo
            const cantOptimo = @Model.CantidadFefoOptimo;
            const cantAtencion = @Model.CantidadFefoAtencion;
            const cantUrgente = @Model.CantidadFefoUrgente;
            const cantVencido = @Model.CantidadFefoVencido;

            const fefoData = [cantOptimo, cantAtencion, cantUrgente, cantVencido];
            const totalFefo = fefoData.reduce((a, b) => a + b, 0);

            const ctxFefo = document.getElementById('fefoChart').getContext('2d');
            const fefoChartInstance = new Chart(ctxFefo, {
                type: 'doughnut',
                data: {
                    labels: ['Óptimo (>15 d)', 'Atención (≤15 d)', 'Urgente (≤5 d)', 'Vencido'],
                    datasets: [{
                        data: totalFefo === 0 ? [1] : fefoData,
                        backgroundColor: totalFefo === 0 ? ['#e5e7eb'] : ['#10b981', '#ffc107', '#fd7e14', '#dc3545'],
                        borderWidth: 2,
                        borderColor: colors.doughnutBorder,
                        hoverOffset: 6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: '70%',
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    if (totalFefo === 0) return ' Sin inventario registrado';
                                    const value = context.parsed;
                                    const percentage = ((value / totalFefo) * 100).toFixed(1);
                                    return ` ${context.label}: ${value} productos (${percentage}%)`;
                                }
                            }
                        }
                    }
                }
            });

            // 4. Observador reactivo al cambio de tema en tiempo real
            const themeObserver = new MutationObserver(() => {
                const updated = getChartColors();
                if (donacionesChartInstance && donacionesChartInstance.options.scales) {
                    donacionesChartInstance.options.scales.y.ticks.color = updated.ticks;
                    donacionesChartInstance.options.scales.x.ticks.color = updated.ticks;
                    donacionesChartInstance.options.scales.y.grid.color = updated.grid;
                    donacionesChartInstance.update();
                }
                if (fefoChartInstance && fefoChartInstance.data.datasets.length > 0) {
                    fefoChartInstance.data.datasets[0].borderColor = updated.doughnutBorder;
                    fefoChartInstance.update();
                }
            });
            themeObserver.observe(document.body, { attributes: true, attributeFilter: ['class'] });
        });
    </script>
}