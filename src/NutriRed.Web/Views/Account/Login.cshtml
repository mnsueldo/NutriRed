@model NutriRed.Web.Models.LoginViewModel
@{
    ViewData["Title"] = "Iniciar Sesión";
    Layout = "_Layout";
}

<div class="row justify-content-center align-items-center py-5">
    <div class="col-12 col-md-8 col-lg-5">
        <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="card-header bg-success bg-gradient text-white text-center py-4 border-0">
                <div class="d-inline-flex p-3 bg-white bg-opacity-25 rounded-circle mb-2">
                    <i class="bi bi-shield-lock-fill fs-1 text-white"></i>
                </div>
                <h3 class="fw-bold mb-1">NutriRed</h3>
                <p class="mb-0 small text-white-50">Acceso Seguro al Sistema de Gestión</p>
            </div>

            <div class="card-body p-4 p-md-5 bg-white">
                <form asp-action="Login" asp-controller="Account" asp-route-returnurl="@ViewData["ReturnUrl"]" method="post" id="loginForm">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 small py-2 px-3 mb-4" role="alert"></div>

                    <!-- Campo Correo / Usuario -->
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-semibold text-secondary">Correo Electrónico</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-envelope"></i></span>
                            <input asp-for="Email" class="form-control bg-light border-start-0" placeholder="ejemplo@nutrired.org" autofocus />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <!-- Campo Contraseña -->
                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <label asp-for="Password" class="form-label fw-semibold text-secondary">Contraseña</label>
                        </div>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-key"></i></span>
                            <input asp-for="Password" class="form-control bg-light border-start-0 border-end-0" placeholder="••••••••" id="passwordInput" />
                            <button class="btn btn-light border border-start-0 text-muted" type="button" id="togglePasswordBtn" title="Mostrar/Ocultar contraseña">
                                <i class="bi bi-eye" id="toggleIcon"></i>
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <!-- Recordarme -->
                    <div class="mb-4 form-check form-switch">
                        <input asp-for="Recordarme" class="form-check-input" type="checkbox" id="recordarmeSwitch" />
                        <label class="form-check-label text-secondary small" for="recordarmeSwitch">Recordarme en este equipo</label>
                    </div>

                    <!-- Botón de Ingreso -->
                    <div class="d-grid mb-4">
                        <button type="submit" class="btn btn-success btn-lg fw-bold rounded-pill shadow-sm py-2">
                            <i class="bi bi-box-arrow-in-right me-2"></i> Iniciar Sesión
                        </button>
                    </div>

                    <!-- Accesos Rápidos de Laboratorio / Demostración UTN -->
                    <div class="p-3 bg-light rounded-3 border border-dashed text-center">
                        <span class="badge bg-secondary mb-2 text-uppercase">Entorno de Evaluación UTN</span>
                        <p class="small text-muted mb-2">Credenciales de prueba preconfiguradas:</p>
                        <div class="d-flex gap-2 justify-content-center">
                            <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3" onclick="fillCredentials('admin@nutrired.org', 'Admin123!')">
                                <i class="bi bi-person-badge me-1"></i> Admin
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-success rounded-pill px-3" onclick="fillCredentials('voluntario@nutrired.org', '123456')">
                                <i class="bi bi-heart me-1"></i> Voluntario
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function fillCredentials(email, pwd) {
            document.querySelector("input[name='Email']").value = email;
            document.querySelector("input[name='Password']").value = pwd;
        }

        document.getElementById("togglePasswordBtn")?.addEventListener("click", function () {
            const pwdInput = document.getElementById("passwordInput");
            const icon = document.getElementById("toggleIcon");
            if (pwdInput.type === "password") {
                pwdInput.type = "text";
                icon.classList.replace("bi-eye", "bi-eye-slash");
            } else {
                pwdInput.type = "password";
                icon.classList.replace("bi-eye-slash", "bi-eye");
            }
        });
    </script>
}
