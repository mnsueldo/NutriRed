@{
    ViewData["Title"] = "Acceso Denegado";
    Layout = "_Layout";
}

<div class="row justify-content-center align-items-center py-5">
    <div class="col-12 col-md-8 col-lg-6 text-center">
        <div class="card border-0 shadow-sm rounded-4 p-5 bg-white">
            <div class="d-inline-flex p-4 bg-danger bg-opacity-10 text-danger rounded-circle mx-auto mb-3">
                <i class="bi bi-shield-x display-3"></i>
            </div>
            <h2 class="fw-bold text-danger mb-2">Acceso No Autorizado (403)</h2>
            <p class="text-secondary mb-4 fs-5">
                Su cuenta actual no cuenta con los permisos necesarios para acceder a este módulo del sistema.
            </p>
            <div class="alert alert-warning text-start small mb-4 rounded-3">
                <i class="bi bi-info-circle-fill me-2"></i>
                Determinadas funciones como la administración del catálogo de alimentos o configuración general están reservadas exclusivamente para usuarios con rol de <strong>Administrador</strong>.
            </div>
            <div class="d-flex gap-3 justify-content-center">
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                    <i class="bi bi-house me-2"></i> Volver al Inicio
                </a>
                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger rounded-pill px-4">
                        <i class="bi bi-box-arrow-right me-2"></i> Cambiar de Usuario
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
