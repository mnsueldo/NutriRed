@model IEnumerable<NutriRed.Web.Models.UsuarioItemViewModel>
@{
    ViewData["Title"] = "Gestión de Usuarios";
    Layout = "_Layout";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h2 class="fw-bold mb-1">
            <i class="bi bi-people-fill text-danger me-2"></i> Padrón de usuarios
        </h2>
        <p class="text-secondary mb-0">Administración de cuentas, roles de voluntariado y accesos al sistema.</p>
    </div>
    <div>
        <a asp-action="Crear" class="btn btn-danger rounded-pill shadow-sm px-4">
            <i class="bi bi-person-plus-fill me-2"></i> Nuevo usuario
        </a>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white mb-4">
    <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
        <span class="fw-semibold text-secondary">
            <i class="bi bi-shield-lock me-1"></i> Cuentas registradas (@Model.Count())
        </span>
        <div class="d-flex gap-2">
            <span class="badge bg-danger bg-opacity-10 text-danger rounded-pill px-3 py-2">
                <i class="bi bi-shield-check me-1"></i> @Model.Count(u => u.Rol == "Administrador") Administradores
            </span>
            <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-2">
                <i class="bi bi-heart me-1"></i> @Model.Count(u => u.Rol == "Voluntario") Voluntarios
            </span>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light text-secondary small text-uppercase">
                <tr>
                    <th class="ps-4">Usuario</th>
                    <th>Rol en el sistema</th>
                    <th>Fecha de alta</th>
                    <th>Estado</th>
                    <th class="text-end pe-4">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center py-5 text-muted">
                            <i class="bi bi-person-x fs-1 d-block mb-2 text-secondary"></i>
                            No hay usuarios registrados en el sistema.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var user in Model)
                    {
                        var isAdmin = user.Rol == "Administrador";
                        var isCurrentLoggedUser = User.Identity?.Name?.Equals(user.Email, StringComparison.OrdinalIgnoreCase) == true;

                        <tr>
                            <td class="ps-4">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="rounded-circle d-flex align-items-center justify-content-center text-white fw-bold shadow-sm @(isAdmin ? "bg-danger" : "bg-success")"
                                         style="width: 42px; height: 42px; font-size: 1rem;">
                                        @(user.NombreCompleto.Length > 0 ? user.NombreCompleto.Substring(0, 1).ToUpper() : "U")
                                    </div>
                                    <div>
                                        <div class="fw-bold text-dark d-flex align-items-center gap-2">
                                            @user.NombreCompleto
                                            @if (isCurrentLoggedUser)
                                            {
                                                <span class="badge bg-primary bg-opacity-10 text-primary border border-primary-subtle" style="font-size: 0.65rem;">Tú</span>
                                            }
                                        </div>
                                        <small class="text-muted"><i class="bi bi-envelope me-1"></i> @user.Email</small>
                                    </div>
                                </div>
                            </td>
                            <td>
                                @if (isAdmin)
                                {
                                    <span class="badge bg-danger rounded-pill px-3 py-2">
                                        <i class="bi bi-shield-check me-1"></i> Administrador
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-success rounded-pill px-3 py-2">
                                        <i class="bi bi-heart me-1"></i> Voluntario
                                    </span>
                                }
                            </td>
                            <td class="text-secondary small">
                                <i class="bi bi-calendar3 me-1"></i> @user.FechaRegistro.ToString("dd/MM/yyyy HH:mm")
                            </td>
                            <td>
                                @if (user.Activo)
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-2">
                                        <i class="bi bi-check-circle-fill me-1"></i> Activo
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary bg-opacity-10 text-secondary rounded-pill px-3 py-2">
                                        <i class="bi bi-dash-circle-fill me-1"></i> Inactivo
                                    </span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                @if (!isCurrentLoggedUser)
                                {
                                    <form asp-action="CambiarEstado" method="post" class="d-inline"
                                          onsubmit="return confirm('¿Está seguro de que desea @(user.Activo ? "desactivar" : "reactivar") la cuenta de @user.NombreCompleto?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@user.Id" />
                                        <input type="hidden" name="nuevoEstado" value="@(!user.Activo)" />

                                        @if (user.Activo)
                                        {
                                            <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3" title="Desactivar cuenta">
                                                <i class="bi bi-person-x me-1"></i> Desactivar
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="submit" class="btn btn-sm btn-outline-success rounded-pill px-3" title="Reactivar cuenta">
                                                <i class="bi bi-person-check me-1"></i> Reactivar
                                            </button>
                                        }
                                    </form>
                                }
                                else
                                {
                                    <span class="text-muted small fst-italic">Cuenta en uso</span>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
