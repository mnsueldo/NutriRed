@model NutriRed.Web.Models.DonacionIndexViewModel
@using NutriRed.Domain.Enums

@{
    ViewData["Title"] = "Recepción de Donaciones";
    bool hayFiltros = Model.FechaDesde.HasValue || Model.FechaHasta.HasValue || !string.IsNullOrWhiteSpace(Model.CodigoComprobante);
}

<!-- Encabezado Principal & Breadcrumbs -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1 small">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none text-muted">Inicio</a></li>
                <li class="breadcrumb-item text-muted">Donaciones</li>
                <li class="breadcrumb-item active text-dark fw-semibold" aria-current="page">Recepción</li>
            </ol>
        </nav>
        <h2 class="fw-bold mb-1 text-dark">
            <i class="bi bi-box2-heart text-success me-2"></i>Recepción de Donaciones
        </h2>
        <p class="text-secondary mb-0">Registro de ingresos de alimentos, control de lotes y emisión de comprobantes oficiales.</p>
    </div>
    <div>
        <a asp-action="Registrar" class="btn btn-success rounded-pill shadow-sm px-4 py-2 fw-semibold">
            <i class="bi bi-plus-circle-fill me-2"></i>Registrar Donación
        </a>
    </div>
</div>

<!-- Panel de Métricas / KPIs Rápidos (Bento Grid) -->
<div class="row g-3 mb-4">
    <div class="col-12 col-md-4">
        <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-circle bg-success bg-opacity-10 p-3 text-success d-flex align-items-center justify-content-center" style="width: 52px; height: 52px;">
                    <i class="bi bi-receipt-cutoff fs-4"></i>
                </div>
                <div>
                    <span class="text-muted small fw-semibold text-uppercase d-block">Comprobantes Registrados</span>
                    <span class="fs-4 fw-bold text-dark">@Model.TotalRegistros</span>
                    <small class="text-muted d-block" style="font-size: 0.72rem;">Ingresos emitidos</small>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-4">
        <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-circle bg-primary bg-opacity-10 p-3 text-primary d-flex align-items-center justify-content-center" style="width: 52px; height: 52px;">
                    <i class="bi bi-boxes fs-4"></i>
                </div>
                <div>
                    <span class="text-muted small fw-semibold text-uppercase d-block">Total Unidades / Kilos</span>
                    <span class="fs-4 fw-bold text-dark">@Model.TotalUnidadesKilos.ToString("N0") <span class="fs-6 text-muted fw-normal">u/kg/L</span></span>
                    <small class="text-muted d-block" style="font-size: 0.72rem;">Mercadería total ingresada</small>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-4">
        <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-circle bg-warning bg-opacity-10 p-3 text-warning-emphasis d-flex align-items-center justify-content-center" style="width: 52px; height: 52px;">
                    <i class="bi bi-building fs-4 text-warning"></i>
                </div>
                <div>
                    <span class="text-muted small fw-semibold text-uppercase d-block">Empresas / Instituciones</span>
                    <span class="fs-4 fw-bold text-warning-emphasis">@Model.DonacionesInstitucionales</span>
                    <small class="text-muted d-block" style="font-size: 0.72rem;">Donantes corporativos</small>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Filtros de Búsqueda -->
<div class="card border-0 shadow-sm rounded-4 p-3 bg-white mb-4">
    <form method="get" asp-action="Index" class="row g-2 align-items-end">
        <div class="col-12 col-sm-6 col-md-3">
            <label class="form-label small text-muted mb-1 fw-semibold">Fecha desde</label>
            <input type="date" name="desde" value="@(Model.FechaDesde?.ToString("yyyy-MM-dd"))" class="form-control bg-light" />
        </div>
        <div class="col-12 col-sm-6 col-md-3">
            <label class="form-label small text-muted mb-1 fw-semibold">Fecha hasta</label>
            <input type="date" name="hasta" value="@(Model.FechaHasta?.ToString("yyyy-MM-dd"))" class="form-control bg-light" />
        </div>
        <div class="col-12 col-sm-8 col-md-4">
            <label class="form-label small text-muted mb-1 fw-semibold">Comprobante exacto</label>
            <div class="input-group">
                <span class="input-group-text bg-light text-muted border-end-0"><i class="bi bi-upc-scan"></i></span>
                <input type="text" name="codigo" value="@Model.CodigoComprobante" placeholder="Ej: DON-2026-00001" class="form-control bg-light border-start-0 font-mono" />
            </div>
        </div>
        <div class="col-12 col-sm-4 col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-primary rounded-pill w-100 shadow-sm fw-semibold">
                <i class="bi bi-funnel me-1"></i> Filtrar
            </button>
            @if (hayFiltros)
            {
                <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3 shadow-sm" title="Limpiar filtros">
                    <i class="bi bi-x-lg"></i>
                </a>
            }
        </div>
    </form>
</div>

<!-- Tabla de Donaciones -->
<div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white mb-4">
    <div class="card-header bg-white py-3 px-4 border-bottom d-flex justify-content-between align-items-center">
        <span class="fw-semibold text-secondary">
            <i class="bi bi-receipt me-1"></i> Historial de Donaciones (@Model.Donaciones.Count())
        </span>
        <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-1">
            <i class="bi bi-shield-check me-1"></i> Trazabilidad Activa
        </span>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light text-secondary small text-uppercase">
                <tr>
                    <th class="ps-4">Comprobante</th>
                    <th>Fecha y Hora</th>
                    <th>Donante</th>
                    <th>Tipo</th>
                    <th class="text-center">Ítems</th>
                    <th class="text-end">Cant. Total</th>
                    <th>Receptor</th>
                    <th class="text-end pe-4">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Donaciones.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center py-5 text-muted">
                            <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary opacity-50"></i>
                            No se encontraron donaciones registradas con los filtros aplicados.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var donacion in Model.Donaciones)
                    {
                        <tr>
                            <td class="ps-4">
                                <span class="code-tag font-mono fw-bold text-dark">@donacion.CodigoComprobante</span>
                            </td>
                            <td>
                                <span class="d-block fw-semibold text-dark">@donacion.FechaHora.ToString("dd/MM/yyyy")</span>
                                <small class="text-muted">@donacion.FechaHora.ToString("HH:mm") hs</small>
                            </td>
                            <td>
                                <span class="d-block fw-semibold text-dark">@donacion.DonanteNombre</span>
                                @if (!string.IsNullOrWhiteSpace(donacion.DonanteDocumento))
                                {
                                    <small class="text-muted font-mono">Doc: @donacion.DonanteDocumento</small>
                                }
                            </td>
                            <td>
                                @switch (donacion.TipoDonante)
                                {
                                    case TipoDonante.Individuo:
                                        <span class="badge bg-info bg-opacity-10 text-info rounded-pill px-3 py-1">Individuo</span>
                                        break;
                                    case TipoDonante.Institucion:
                                        <span class="badge bg-warning bg-opacity-10 text-warning-emphasis rounded-pill px-3 py-1">Institución / Empresa</span>
                                        break;
                                    case TipoDonante.Anonimo:
                                        <span class="badge bg-secondary bg-opacity-10 text-secondary rounded-pill px-3 py-1">Anónimo</span>
                                        break;
                                }
                            </td>
                            <td class="text-center">
                                <span class="badge bg-light text-dark border rounded-pill px-2 py-1">
                                    @donacion.Detalles.Count @(donacion.Detalles.Count == 1 ? "alimento" : "alimentos")
                                </span>
                            </td>
                            <td class="text-end fw-bold text-success font-mono">
                                @donacion.TotalUnidadesRecibidas.ToString("N0")
                            </td>
                            <td>
                                <small class="text-muted"><i class="bi bi-person me-1"></i>@donacion.VoluntarioReceptorId</small>
                            </td>
                            <td class="text-end pe-4">
                                <a asp-action="Comprobante" asp-route-id="@donacion.DonacionId" class="btn btn-sm btn-outline-primary rounded-pill px-3 fw-semibold" title="Ver Comprobante Oficial">
                                    <i class="bi bi-receipt me-1"></i> Comprobante
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
