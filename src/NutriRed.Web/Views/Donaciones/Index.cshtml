@model NutriRed.Web.Models.DonacionIndexViewModel
@using NutriRed.Domain.Enums

@{
    ViewData["Title"] = "Recepción de donaciones";
    bool hayFiltros = Model.FechaDesde.HasValue || Model.FechaHasta.HasValue || !string.IsNullOrWhiteSpace(Model.CodigoComprobante);
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h2 class="fw-bold mb-1">
            <i class="bi bi-box-seam text-success me-2"></i>Recepción de donaciones
        </h2>
        <p class="text-muted mb-0">Registro de ingresos de alimentos, control de lotes y emisión de comprobantes oficiales.</p>
    </div>
    <a asp-action="Registrar" class="btn btn-emerald shadow-sm">
        <i class="bi bi-plus-circle me-1"></i> Registrar nueva donación
    </a>
</div>

<partial name="_Alertas" />

<!-- Tarjetas de Resumen Rápido -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card card-nr border-0 shadow-sm p-3">
            <div class="d-flex align-items-center">
                <div class="rounded-circle bg-emerald-light p-3 text-success me-3">
                    <i class="bi bi-receipt-cutoff fs-3"></i>
                </div>
                <div>
                    <span class="text-muted small d-block">Comprobantes registrados</span>
                    <h3 class="fw-bold mb-0 text-dark">@Model.TotalRegistros</h3>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card card-nr border-0 shadow-sm p-3">
            <div class="d-flex align-items-center">
                <div class="rounded-circle bg-primary bg-opacity-10 p-3 text-primary me-3">
                    <i class="bi bi-boxes fs-3"></i>
                </div>
                <div>
                    <span class="text-muted small d-block">Total unidades / Kilos</span>
                    <h3 class="fw-bold mb-0 text-dark">@Model.TotalUnidadesKilos.ToString("N1")</h3>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card card-nr border-0 shadow-sm p-3">
            <div class="d-flex align-items-center">
                <div class="rounded-circle bg-warning bg-opacity-10 p-3 text-warning me-3">
                    <i class="bi bi-building fs-3"></i>
                </div>
                <div>
                    <span class="text-muted small d-block">Empresas / Instituciones</span>
                    <h3 class="fw-bold mb-0 text-dark">@Model.DonacionesInstitucionales</h3>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Filtros de Búsqueda -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-end">
            <div class="col-md-3 col-sm-6">
                <label class="form-label small text-muted mb-1">Fecha desde</label>
                <input type="date" name="desde" value="@(Model.FechaDesde?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" />
            </div>
            <div class="col-md-3 col-sm-6">
                <label class="form-label small text-muted mb-1">Fecha hasta</label>
                <input type="date" name="hasta" value="@(Model.FechaHasta?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" />
            </div>
            <div class="col-md-4 col-sm-8">
                <label class="form-label small text-muted mb-1">Comprobante exacto</label>
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-light text-muted"><i class="bi bi-upc-scan"></i></span>
                    <input type="text" name="codigo" value="@Model.CodigoComprobante" placeholder="Ej: DON-2026-00001" class="form-control form-control-sm" />
                </div>
            </div>
            <div class="col-md-2 col-sm-4 d-flex gap-2">
                <button type="submit" class="btn btn-sm btn-primary w-100">
                    <i class="bi bi-funnel me-1"></i> Filtrar
                </button>
                @if (hayFiltros)
                {
                    <a asp-action="Index" class="btn btn-sm btn-outline-secondary" title="Limpiar filtros">
                        <i class="bi bi-x-lg"></i>
                    </a>
                }
            </div>
        </form>
    </div>
</div>

<!-- Tabla de Donaciones -->
<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">Comprobante</th>
                        <th>Fecha y Hora</th>
                        <th>Donante</th>
                        <th>Tipo</th>
                        <th class="text-center">Ítems</th>
                        <th class="text-end">Cant. Total</th>
                        <th>Receptor</th>
                        <th class="text-end pe-3">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Donaciones.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary opacity-50"></i>
                                No se encontraron donaciones registradas con los filtros aplicados.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var donacion in Model.Donaciones)
                        {
                            <tr>
                                <td class="ps-3">
                                    <span class="code-tag fw-bold text-dark">@donacion.CodigoComprobante</span>
                                </td>
                                <td>
                                    <span class="d-block fw-semibold text-dark">@donacion.FechaHora.ToString("dd/MM/yyyy")</span>
                                    <small class="text-muted">@donacion.FechaHora.ToString("HH:mm") hs</small>
                                </td>
                                <td>
                                    <span class="d-block fw-semibold text-dark">@donacion.DonanteNombre</span>
                                    @if (!string.IsNullOrWhiteSpace(donacion.DonanteDocumento))
                                    {
                                        <small class="text-muted">Doc: @donacion.DonanteDocumento</small>
                                    }
                                </td>
                                <td>
                                    @switch (donacion.TipoDonante)
                                    {
                                        case TipoDonante.Individuo:
                                            <span class="badge bg-info bg-opacity-10 text-info border border-info border-opacity-25 px-2 py-1">Individuo</span>
                                            break;
                                        case TipoDonante.Institucion:
                                            <span class="badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25 px-2 py-1">Institución / Empresa</span>
                                            break;
                                        case TipoDonante.Anonimo:
                                            <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25 px-2 py-1">Anónimo</span>
                                            break;
                                    }
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-light text-dark border px-2 py-1">
                                        @donacion.Detalles.Count @(donacion.Detalles.Count == 1 ? "alimento" : "alimentos")
                                    </span>
                                </td>
                                <td class="text-end fw-bold text-success">
                                    @donacion.TotalUnidadesRecibidas.ToString("N1")
                                </td>
                                <td>
                                    <small class="text-muted"><i class="bi bi-person me-1"></i>@donacion.VoluntarioReceptorId</small>
                                </td>
                                <td class="text-end pe-3">
                                    <a asp-action="Comprobante" asp-route-id="@donacion.DonacionId" class="btn btn-sm btn-outline-primary" title="Ver Comprobante Oficial">
                                        <i class="bi bi-receipt me-1"></i> Comprobante
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
