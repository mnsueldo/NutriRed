@using System.Globalization
@{
    ViewData["Title"] = "Inicio - Circuito Operativo";
    var fechaActual = DateTime.Now.ToString("dddd, d 'de' MMMM 'de' yyyy", new CultureInfo("es-ES"));
    fechaActual = char.ToUpper(fechaActual[0]) + fechaActual.Substring(1);
}

<!-- Hero: Bienvenida Operativa -->
<div class="card card-nr border-0 shadow-sm mb-4" style="background: linear-gradient(135deg, #ecfdf5 0%, #f0fdf4 100%); border-left: 5px solid var(--nr-emerald-primary) !important;">
    <div class="card-body p-4 p-lg-5">
        <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-4">
            <div>
                <div class="d-inline-flex align-items-center gap-2 bg-white bg-opacity-75 border border-success-subtle rounded-pill px-3 py-1 mb-3 shadow-sm">
                    <span class="spinner-grow spinner-grow-sm text-success" style="width: 0.55rem; height: 0.55rem;" role="status"></span>
                    <small class="fw-semibold text-success">Banco de Alimentos Activo</small>
                </div>
                <h1 class="h2 fw-bold text-dark mb-2">
                    ¡Bienvenido, @(User.Identity?.Name?.Split('@')[0] ?? "Operador")! 👋
                </h1>
                <p class="text-secondary mb-0" style="max-width: 680px;">
                    Plataforma logística integral para la recepción física de donaciones, control de caducidad <strong>FEFO</strong>, 
                    preparación asistencial y entrega transparente a familias beneficiarias.
                </p>
            </div>

            <div class="d-flex flex-column flex-sm-row gap-2">
                <a asp-controller="Dashboard" asp-action="Index" class="btn btn-emerald rounded-pill px-4 py-2 shadow-sm text-nowrap fw-semibold">
                    <i class="bi bi-speedometer2 me-2"></i> Ver Dashboard
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Cabecera de Sección: El Circuito Operativo -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2 mb-3">
    <div>
        <h2 class="h5 fw-bold text-dark mb-0">
            <i class="bi bi-arrow-repeat text-success me-2"></i>Circuito Operativo del Banco
        </h2>
        <small class="text-muted">Ciclo continuo de 4 fases para la gestión y entrega de alimentos</small>
    </div>
    <div class="text-muted small">
        <i class="bi bi-calendar3 me-1"></i> @fechaActual
    </div>
</div>

<!-- Retícula de Pasos Secuenciales con Split / Segmented Buttons -->
<div class="row g-4 mb-4">
    <!-- Paso 01: Recepción -->
    <div class="col-md-6 col-xl-3">
        <div class="card card-nr card-nr-hover h-100 p-3 shadow-sm" style="border-top: 4px solid #2563eb !important;">
            <div class="d-flex justify-content-between align-items-start mb-3">
                <div class="p-3 rounded-4 shadow-sm" style="background: #eff6ff; color: #2563eb;">
                    <i class="bi bi-box-arrow-in-down fs-3"></i>
                </div>
                <span class="badge rounded-pill bg-primary-subtle text-primary border border-primary-subtle px-2 py-1 fw-bold">
                    Paso 01
                </span>
            </div>
            <h3 class="h6 fw-bold text-dark mb-1">Recepción</h3>
            <p class="text-secondary small mb-3">
                Recepción física de alimentos, registro de donantes, validación de vencimiento y comprobantes.
            </p>
            <div class="mt-auto pt-3 border-top">
                <div class="btn-group w-100 rounded-pill shadow-sm overflow-hidden" role="group">
                    <a asp-controller="Donaciones" asp-action="Registrar" class="btn btn-sm btn-primary flex-grow-1 fw-semibold text-center">
                        <i class="bi bi-plus-circle me-1"></i> Registrar
                    </a>
                    <a asp-controller="Donaciones" asp-action="Index" class="btn btn-sm btn-primary px-3 border-start border-white border-opacity-25" title="Ver historial de donaciones">
                        <i class="bi bi-list-ul"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Paso 02: Control de stock -->
    <div class="col-md-6 col-xl-3">
        <div class="card card-nr card-nr-hover h-100 p-3 shadow-sm" style="border-top: 4px solid #059669 !important;">
            <div class="d-flex justify-content-between align-items-start mb-3">
                <div class="p-3 rounded-4 shadow-sm" style="background: #ecfdf5; color: #059669;">
                    <i class="bi bi-boxes fs-3"></i>
                </div>
                <span class="badge rounded-pill bg-success-subtle text-success border border-success-subtle px-2 py-1 fw-bold">
                    Paso 02
                </span>
            </div>
            <h3 class="h6 fw-bold text-dark mb-1">Control de stock</h3>
            <p class="text-secondary small mb-3">
                Supervisión de existencias en tiempo real, trazabilidad por lote y gestión del catálogo de alimentos.
            </p>
            <div class="mt-auto pt-3 border-top">
                <div class="btn-group w-100 rounded-pill shadow-sm overflow-hidden" role="group">
                    <a asp-controller="Inventario" asp-action="Index" class="btn btn-sm btn-emerald flex-grow-1 fw-semibold text-center">
                        <i class="bi bi-search me-1"></i> Consultar
                    </a>
                    <a asp-controller="Productos" asp-action="Index" class="btn btn-sm btn-emerald px-3 border-start border-white border-opacity-25" title="Ver catálogo de alimentos">
                        <i class="bi bi-grid"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Paso 03: Armado de Kits -->
    <div class="col-md-6 col-xl-3">
        <div class="card card-nr card-nr-hover h-100 p-3 shadow-sm" style="border-top: 4px solid #d97706 !important;">
            <div class="d-flex justify-content-between align-items-start mb-3">
                <div class="p-3 rounded-4 shadow-sm" style="background: #fef3c7; color: #d97706;">
                    <i class="bi bi-box-seam fs-3"></i>
                </div>
                <span class="badge rounded-pill bg-warning-subtle text-warning border border-warning-subtle px-2 py-1 fw-bold">
                    Paso 03
                </span>
            </div>
            <h3 class="h6 fw-bold text-dark mb-1">Armado de Kits</h3>
            <p class="text-secondary small mb-3">
                Ensamblado de módulos asistenciales según grupo familiar, consumo de lotes FEFO y rotulación QR.
            </p>
            <div class="mt-auto pt-3 border-top">
                <div class="btn-group w-100 rounded-pill shadow-sm overflow-hidden" role="group">
                    <a asp-controller="Paquetes" asp-action="Armar" class="btn btn-sm btn-warning text-dark flex-grow-1 fw-semibold text-center">
                        <i class="bi bi-magic me-1"></i> Armar Kit
                    </a>
                    <a asp-controller="Paquetes" asp-action="Index" class="btn btn-sm btn-warning text-dark px-3 border-start border-dark border-opacity-25" title="Ver paquetes preparados">
                        <i class="bi bi-list-check"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Paso 04: Despacho -->
    <div class="col-md-6 col-xl-3">
        <div class="card card-nr card-nr-hover h-100 p-3 shadow-sm" style="border-top: 4px solid #db2777 !important;">
            <div class="d-flex justify-content-between align-items-start mb-3">
                <div class="p-3 rounded-4 shadow-sm" style="background: #fdf2f8; color: #db2777;">
                    <i class="bi bi-truck fs-3"></i>
                </div>
                <span class="badge rounded-pill bg-danger-subtle text-danger border border-danger-subtle px-2 py-1 fw-bold">
                    Paso 04
                </span>
            </div>
            <h3 class="h6 fw-bold text-dark mb-1">Despacho</h3>
            <p class="text-secondary small mb-3">
                Entrega formal a familias beneficiarias, validación del receptor y constancia digital con firma.
            </p>
            <div class="mt-auto pt-3 border-top">
                <div class="btn-group w-100 rounded-pill shadow-sm overflow-hidden" role="group">
                    <a asp-controller="Entregas" asp-action="Index" class="btn btn-sm btn-danger flex-grow-1 fw-semibold text-center">
                        <i class="bi bi-truck me-1"></i> Despachar
                    </a>
                    <a asp-controller="Entregas" asp-action="Index" asp-route-tab="historial" class="btn btn-sm btn-danger px-3 border-start border-white border-opacity-25" title="Ver historial de entregas">
                        <i class="bi bi-clock-history"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Tarjetas de Gestión y Padrón con Acento Lateral -->
<div class="row g-4">
    <!-- Familias Beneficiarias -->
    <div class="col-md-6">
        <div class="card card-nr p-3 h-100 shadow-sm border-0 border-start border-4 border-success">
            <div class="d-flex flex-column flex-sm-row align-items-sm-center justify-content-between gap-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="p-3 rounded-circle bg-success-subtle text-success">
                        <i class="bi bi-people-fill fs-4"></i>
                    </div>
                    <div>
                        <h4 class="h6 fw-bold mb-1 text-dark">Familias Beneficiarias</h4>
                        <p class="text-secondary small mb-0">
                            Padrón social, integrantes familiares y cobertura asistencial.
                        </p>
                    </div>
                </div>
                <div class="d-flex gap-2 align-self-end align-self-sm-center">
                    <a asp-controller="Familias" asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                        Padrón
                    </a>
                    <a asp-controller="Familias" asp-action="Crear" class="btn btn-emerald btn-sm rounded-pill px-3 shadow-sm">
                        <i class="bi bi-person-plus me-1"></i> Registrar
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Categorías -->
    <div class="col-md-6">
        <div class="card card-nr p-3 h-100 shadow-sm border-0 border-start border-4 border-primary">
            <div class="d-flex flex-column flex-sm-row align-items-sm-center justify-content-between gap-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="p-3 rounded-circle bg-primary-subtle text-primary">
                        <i class="bi bi-tags-fill fs-4"></i>
                    </div>
                    <div>
                        <h4 class="h6 fw-bold mb-1 text-dark">Categorías</h4>
                        <p class="text-secondary small mb-0">
                            Grupos nutricionales, unidades de medida y reglas de reemplazo.
                        </p>
                    </div>
                </div>
                <div class="align-self-end align-self-sm-center">
                    <a asp-controller="Categorias" asp-action="Index" class="btn btn-outline-primary btn-sm rounded-pill px-3">
                        Administrar <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
