@model NutriRed.Web.Models.PaqueteIndexViewModel
@using NutriRed.Domain.Enums

@{
    ViewData["Title"] = "Gestión de Paquetes Asistenciales";
    bool hayFiltros = Model.EstadoFiltro.HasValue || !string.IsNullOrWhiteSpace(Model.CodigoSeguimiento);
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h2 class="fw-bold mb-1">
            <i class="bi bi-box2 text-primary me-2"></i>Paquetes Nutricionales
        </h2>
        <p class="text-muted mb-0">Armado asistencial, rotulación QR y trazabilidad FEFO de entregas (RF2 / RF3)</p>
    </div>
    <a asp-action="Armar" class="btn btn-emerald shadow-sm">
        <i class="bi bi-magic me-1"></i> Armado Inteligente de Kit
    </a>
</div>

<partial name="_Alertas" />

<!-- Tarjetas de Métricas Rápidas -->
<div class="row g-3 mb-4">
    <div class="col-md-3 col-sm-6">
        <div class="card card-nr border-0 shadow-sm p-3">
            <div class="d-flex align-items-center">
                <div class="rounded-circle bg-primary bg-opacity-10 p-3 text-primary me-3">
                    <i class="bi bi-boxes fs-4"></i>
                </div>
                <div>
                    <span class="text-muted small d-block">Total Paquetes</span>
                    <h3 class="fw-bold mb-0 text-dark">@Model.TotalPaquetes</h3>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="card card-nr border-0 shadow-sm p-3">
            <div class="d-flex align-items-center">
                <div class="rounded-circle bg-warning bg-opacity-10 p-3 text-warning me-3">
                    <i class="bi bi-hourglass-split fs-4"></i>
                </div>
                <div>
                    <span class="text-muted small d-block">Pendientes</span>
                    <h3 class="fw-bold mb-0 text-dark">@Model.Pendientes</h3>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="card card-nr border-0 shadow-sm p-3">
            <div class="d-flex align-items-center">
                <div class="rounded-circle bg-info bg-opacity-10 p-3 text-info me-3">
                    <i class="bi bi-box-seam fs-4"></i>
                </div>
                <div>
                    <span class="text-muted small d-block">Preparados (En Depósito)</span>
                    <h3 class="fw-bold mb-0 text-dark">@Model.Preparados</h3>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="card card-nr border-0 shadow-sm p-3">
            <div class="d-flex align-items-center">
                <div class="rounded-circle bg-success bg-opacity-10 p-3 text-success me-3">
                    <i class="bi bi-check2-circle fs-4"></i>
                </div>
                <div>
                    <span class="text-muted small d-block">Entregados</span>
                    <h3 class="fw-bold mb-0 text-dark">@Model.Entregados</h3>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Filtros de Búsqueda -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-end">
            <div class="col-md-4 col-sm-6">
                <label class="form-label small text-muted mb-1">Filtrar por Estado</label>
                <select name="estado" class="form-select form-select-sm">
                    <option value="">-- Todos los estados --</option>
                    @foreach (var estado in Enum.GetValues<EstadoPaquete>())
                    {
                        <option value="@estado" selected="@(Model.EstadoFiltro == estado)">
                            @estado
                        </option>
                    }
                </select>
            </div>
            <div class="col-md-5 col-sm-6">
                <label class="form-label small text-muted mb-1">Código QR / Seguimiento</label>
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-light text-muted"><i class="bi bi-qr-code"></i></span>
                    <input type="text" name="codigo" value="@Model.CodigoSeguimiento" placeholder="Ej: PKG-2026-00001" class="form-control form-control-sm font-mono" />
                </div>
            </div>
            <div class="col-md-3 col-sm-12 d-flex gap-2">
                <button type="submit" class="btn btn-sm btn-primary w-100">
                    <i class="bi bi-funnel me-1"></i> Filtrar
                </button>
                @if (hayFiltros)
                {
                    <a asp-action="Index" class="btn btn-sm btn-outline-secondary" title="Limpiar filtros">
                        <i class="bi bi-x-lg"></i>
                    </a>
                }
            </div>
        </form>
    </div>
</div>

<!-- Tabla de Paquetes -->
<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">Código QR / Seguimiento</th>
                        <th>Familia Destinataria</th>
                        <th>Kit Nutricional</th>
                        <th>Fecha Armado</th>
                        <th>Estado</th>
                        <th>Alimentos</th>
                        <th class="text-end pe-3">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Paquetes.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <i class="bi bi-box fs-1 d-block mb-2 text-secondary opacity-50"></i>
                                No se encontraron paquetes armados con los filtros aplicados.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var pkg in Model.Paquetes)
                        {
                            <tr>
                                <td class="ps-3">
                                    <span class="code-tag font-mono fw-bold text-dark">
                                        <i class="bi bi-qr-code me-1 text-primary"></i>@pkg.CodigoSeguimiento
                                    </span>
                                </td>
                                <td>
                                    <span class="fw-semibold text-dark d-block">@pkg.FamiliaTitular</span>
                                    <small class="text-muted font-mono">DNI: @pkg.DniTitular</small>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">@pkg.TipoPaqueteNombre</span>
                                </td>
                                <td>
                                    <span class="d-block small text-dark">@pkg.FechaCreacion.ToString("dd/MM/yyyy")</span>
                                    <small class="text-muted">@pkg.FechaCreacion.ToString("HH:mm") hs</small>
                                </td>
                                <td>
                                    @switch (pkg.Estado)
                                    {
                                        case EstadoPaquete.Pendiente:
                                            <span class="badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25 px-2 py-1">Pendiente</span>
                                            break;
                                        case EstadoPaquete.Preparado:
                                            <span class="badge bg-info bg-opacity-10 text-info border border-info border-opacity-25 px-2 py-1">Preparado (Listo)</span>
                                            break;
                                        case EstadoPaquete.Entregado:
                                            <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-2 py-1">Entregado</span>
                                            break;
                                        case EstadoPaquete.Cancelado:
                                            <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 px-2 py-1">Cancelado</span>
                                            break;
                                    }
                                </td>
                                <td>
                                    <span class="small text-muted">@pkg.Items.Count variedades</span>
                                </td>
                                <td class="text-end pe-3">
                                    <a asp-action="Detalles" asp-route-id="@pkg.Id" class="btn btn-sm btn-outline-primary" title="Ver Ficha y Rótulo QR">
                                        <i class="bi bi-eye me-1"></i> Ficha & Rótulo
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
