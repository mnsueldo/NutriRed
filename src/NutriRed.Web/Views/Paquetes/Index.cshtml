@model NutriRed.Web.Models.PaqueteIndexViewModel
@using NutriRed.Domain.Enums

@{
    ViewData["Title"] = "Gestión de Paquetes Asistenciales";
    bool hayFiltros = Model.EstadoFiltro.HasValue || !string.IsNullOrWhiteSpace(Model.CodigoSeguimiento);
}

<!-- Encabezado Principal & Breadcrumbs -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1 small">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none text-muted">Inicio</a></li>
                <li class="breadcrumb-item text-muted">Kits Nutricionales</li>
                <li class="breadcrumb-item active text-dark fw-semibold" aria-current="page">Paquetes</li>
            </ol>
        </nav>
        <h2 class="fw-bold mb-1 text-dark">
            <i class="bi bi-box-seam-fill text-success me-2"></i>Paquetes Nutricionales
        </h2>
        <p class="text-secondary mb-0">Armado asistencial, rotulación QR y trazabilidad de entregas en depósito.</p>
    </div>
    <div>
        <a asp-action="Armar" class="btn btn-success rounded-pill shadow-sm px-4 py-2 fw-semibold">
            <i class="bi bi-magic me-2"></i>Armar Nuevo Kit
        </a>
    </div>
</div>

<!-- Panel de Métricas / KPIs Rápidos (Bento Grid) -->
<div class="row g-3 mb-4">
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-circle bg-primary bg-opacity-10 p-3 text-primary d-flex align-items-center justify-content-center" style="width: 52px; height: 52px;">
                    <i class="bi bi-boxes fs-4"></i>
                </div>
                <div>
                    <span class="text-muted small fw-semibold text-uppercase d-block">Total Paquetes</span>
                    <span class="fs-4 fw-bold text-dark">@Model.TotalPaquetes</span>
                    <small class="text-muted d-block" style="font-size: 0.72rem;">Historial acumulado</small>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-circle bg-warning bg-opacity-10 p-3 text-warning-emphasis d-flex align-items-center justify-content-center" style="width: 52px; height: 52px;">
                    <i class="bi bi-hourglass-split fs-4 text-warning"></i>
                </div>
                <div>
                    <span class="text-muted small fw-semibold text-uppercase d-block">Pendientes</span>
                    <span class="fs-4 fw-bold text-warning-emphasis">@Model.Pendientes</span>
                    <small class="text-muted d-block" style="font-size: 0.72rem;">En preparación</small>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-circle bg-info bg-opacity-10 p-3 text-info d-flex align-items-center justify-content-center" style="width: 52px; height: 52px;">
                    <i class="bi bi-box-seam fs-4"></i>
                </div>
                <div>
                    <span class="text-muted small fw-semibold text-uppercase d-block">Listos en Depósito</span>
                    <span class="fs-4 fw-bold text-dark">@Model.Preparados</span>
                    <small class="text-muted d-block" style="font-size: 0.72rem;">Para retiro o despacho</small>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-circle bg-success bg-opacity-10 p-3 text-success d-flex align-items-center justify-content-center" style="width: 52px; height: 52px;">
                    <i class="bi bi-check2-circle fs-4"></i>
                </div>
                <div>
                    <span class="text-muted small fw-semibold text-uppercase d-block">Entregados</span>
                    <span class="fs-4 fw-bold text-success">@Model.Entregados</span>
                    <small class="text-muted d-block" style="font-size: 0.72rem;">Recepción confirmada</small>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Filtros de Búsqueda -->
<div class="card border-0 shadow-sm rounded-4 p-3 bg-white mb-4">
    <form method="get" asp-action="Index" class="row g-2 align-items-end">
        <div class="col-12 col-sm-6 col-md-4">
            <label class="form-label small text-muted mb-1 fw-semibold">Filtrar por estado</label>
            <select name="estado" class="form-select bg-light">
                <option value="">Todos los estados</option>
                @foreach (var estado in Enum.GetValues<EstadoPaquete>())
                {
                    <option value="@estado" selected="@(Model.EstadoFiltro == estado)">
                        @estado
                    </option>
                }
            </select>
        </div>
        <div class="col-12 col-sm-6 col-md-5">
            <label class="form-label small text-muted mb-1 fw-semibold">Código QR / Seguimiento</label>
            <div class="input-group">
                <span class="input-group-text bg-light text-muted border-end-0"><i class="bi bi-qr-code"></i></span>
                <input type="text" name="codigo" value="@Model.CodigoSeguimiento" placeholder="Ej: PKG-2026-00001" class="form-control bg-light border-start-0 font-mono" />
            </div>
        </div>
        <div class="col-12 col-sm-12 col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-primary rounded-pill w-100 shadow-sm fw-semibold">
                <i class="bi bi-funnel me-1"></i> Filtrar
            </button>
            @if (hayFiltros)
            {
                <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3 shadow-sm" title="Limpiar filtros">
                    <i class="bi bi-x-lg"></i>
                </a>
            }
        </div>
    </form>
</div>

<!-- Tabla de Paquetes -->
<div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white mb-4">
    <div class="card-header bg-white py-3 px-4 border-bottom d-flex justify-content-between align-items-center">
        <span class="fw-semibold text-secondary">
            <i class="bi bi-boxes me-1"></i> Cajas Asistenciales (@Model.Paquetes.Count())
        </span>
        <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-1">
            <i class="bi bi-qr-code-scan me-1"></i> Rotulación FEFO
        </span>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light text-secondary small text-uppercase">
                <tr>
                    <th class="ps-4">Código QR / Seguimiento</th>
                    <th>Familia Destinataria</th>
                    <th>Kit Nutricional</th>
                    <th>Fecha Armado</th>
                    <th>Estado</th>
                    <th>Alimentos</th>
                    <th class="text-end pe-4">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Paquetes.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <i class="bi bi-box fs-1 d-block mb-2 text-secondary opacity-50"></i>
                            No se encontraron paquetes armados con los filtros aplicados.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var pkg in Model.Paquetes)
                    {
                        <tr>
                            <td class="ps-4">
                                <span class="code-tag font-mono fw-bold text-dark">
                                    <i class="bi bi-qr-code me-1 text-primary"></i>@pkg.CodigoSeguimiento
                                </span>
                            </td>
                            <td>
                                <span class="fw-semibold text-dark d-block">@pkg.FamiliaTitular</span>
                                <small class="text-muted font-mono">DNI: @pkg.DniTitular</small>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border rounded-pill px-3 py-1">@pkg.TipoPaqueteNombre</span>
                            </td>
                            <td>
                                <span class="d-block small fw-semibold text-dark">@pkg.FechaCreacion.ToString("dd/MM/yyyy")</span>
                                <small class="text-muted">@pkg.FechaCreacion.ToString("HH:mm") hs</small>
                            </td>
                            <td>
                                @switch (pkg.Estado)
                                {
                                    case EstadoPaquete.Pendiente:
                                        <span class="badge bg-warning bg-opacity-10 text-warning-emphasis rounded-pill px-3 py-1">Pendiente</span>
                                        break;
                                    case EstadoPaquete.Preparado:
                                        <span class="badge bg-info bg-opacity-10 text-info rounded-pill px-3 py-1">Listo en depósito</span>
                                        break;
                                    case EstadoPaquete.Entregado:
                                        <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-1">Entregado</span>
                                        break;
                                    case EstadoPaquete.Cancelado:
                                        <span class="badge bg-danger bg-opacity-10 text-danger rounded-pill px-3 py-1">Cancelado</span>
                                        break;
                                }
                            </td>
                            <td>
                                <span class="small text-muted font-mono">@pkg.Items.Count variedades</span>
                            </td>
                            <td class="text-end pe-4">
                                <a asp-action="Detalles" asp-route-id="@pkg.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3 fw-semibold" title="Ver Ficha y Rótulo QR">
                                    <i class="bi bi-eye me-1"></i> Ficha & Rótulo
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
