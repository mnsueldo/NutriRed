@model NutriRed.Web.Models.ArmarPaqueteViewModel
@using NutriRed.Domain.Entities
@using NutriRed.Domain.Enums

@{
    ViewData["Title"] = "Armado Inteligente de Paquetes";
    var familias = ViewBag.Familias as List<FamiliaBeneficiaria> ?? new List<FamiliaBeneficiaria>();
    var tiposPaquete = ViewBag.TiposPaquete as List<TipoPaquete> ?? new List<TipoPaquete>();
    var productosCatalogo = ViewBag.Productos as List<Producto> ?? new List<Producto>();
    bool tienePropuestaInicial = Model.Propuesta != null;
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1 small">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none text-muted">Inicio</a></li>
                <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none text-muted">Kits Nutricionales</a></li>
                <li class="breadcrumb-item active text-dark fw-semibold" aria-current="page">Armado de Kit</li>
            </ol>
        </nav>
        <h2 class="fw-bold mb-1 text-dark">
            <i class="bi bi-magic text-success me-2"></i>Asistente de Armado Inteligente
        </h2>
        <p class="text-secondary mb-0">Selección automática de kits por tamaño familiar, asignación FEFO de lotes y sustitución supervisada.</p>
    </div>
    <div>
        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3 shadow-sm fw-semibold">
            <i class="bi bi-arrow-left me-1"></i> Volver a Paquetes
        </a>
    </div>
</div>

<!-- WIZARD VISUAL DE PROGRESO DE ARMADO (3 ETAPAS) -->
<div class="card border-0 shadow-sm rounded-4 p-3 bg-white mb-4">
    <div class="row g-2 align-items-center text-center">
        <!-- Etapa 1 -->
        <div class="col-4">
            <div class="p-2 rounded-3" id="wizardPaso1">
                <div class="d-flex flex-column flex-md-row align-items-center justify-content-center gap-2">
                    <span class="rounded-circle d-flex align-items-center justify-content-center fw-bold shadow-sm"
                          id="wizardIcono1"
                          style="width: 38px; height: 38px; background: @(tienePropuestaInicial ? "#059669" : "#059669"); color: #ffffff;">
                        <i class="bi @(tienePropuestaInicial ? "bi-check-lg" : "bi-person-check") fs-5"></i>
                    </span>
                    <div class="text-start d-none d-md-block">
                        <small class="d-block text-muted text-uppercase fw-semibold" style="font-size: 0.68rem;">Etapa 1</small>
                        <strong class="d-block text-dark small" id="wizardTexto1">Destinatario</strong>
                    </div>
                </div>
            </div>
        </div>

        <!-- Etapa 2 -->
        <div class="col-4">
            <div class="p-2 rounded-3 @(tienePropuestaInicial ? "" : "opacity-50")" id="wizardPaso2">
                <div class="d-flex flex-column flex-md-row align-items-center justify-content-center gap-2">
                    <span class="rounded-circle d-flex align-items-center justify-content-center fw-bold shadow-sm"
                          id="wizardIcono2"
                          style="width: 38px; height: 38px; background: @(tienePropuestaInicial ? "#059669" : "#e2e8f0"); color: @(tienePropuestaInicial ? "#ffffff" : "#475569");">
                        <i class="bi bi-boxes fs-5"></i>
                    </span>
                    <div class="text-start d-none d-md-block">
                        <small class="d-block text-muted text-uppercase fw-semibold" style="font-size: 0.68rem;">Etapa 2</small>
                        <strong class="d-block @(tienePropuestaInicial ? "text-dark" : "text-secondary") small" id="wizardTexto2">Receta & FEFO</strong>
                    </div>
                </div>
            </div>
        </div>

        <!-- Etapa 3 -->
        <div class="col-4">
            <div class="p-2 rounded-3 opacity-50" id="wizardPaso3">
                <div class="d-flex flex-column flex-md-row align-items-center justify-content-center gap-2">
                    <span class="rounded-circle d-flex align-items-center justify-content-center fw-bold shadow-sm"
                          id="wizardIcono3"
                          style="width: 38px; height: 38px; background: #e2e8f0; color: #475569;">
                        <i class="bi bi-qr-code fs-5"></i>
                    </span>
                    <div class="text-start d-none d-md-block">
                        <small class="d-block text-muted text-uppercase fw-semibold" style="font-size: 0.68rem;">Etapa 3</small>
                        <strong class="d-block text-secondary small" id="wizardTexto3">Rótulo QR</strong>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Formulario Unificado de Armado -->
<form asp-action="ConfirmarArmado" method="post" id="formArmadoPaquete">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4 shadow-sm border-start border-4 border-danger rounded-3" role="alert"></div>

    <!-- PASO 1: SELECCIÓN DE FAMILIA Y KIT -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white mb-4">
        <div class="card-header border-bottom p-3 px-4 bg-white d-flex align-items-center justify-content-between">
            <span class="fw-bold text-dark fs-6">
                <i class="bi bi-people text-primary me-2"></i>1. Destinatario y Plantilla de Kit
            </span>
            <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill px-3 py-1">Asignación automática</span>
        </div>
        <div class="card-body p-4">
            <div class="row g-3 align-items-end">
                <div class="col-lg-6 col-md-7">
                    <label asp-for="FamiliaId" class="form-label fw-semibold">Familia beneficiaria destinataria</label>
                    <select asp-for="FamiliaId" class="form-select" id="comboFamilia">
                        <option value=""> Seleccionar familia titular </option>
                        @foreach (var fam in familias)
                        {
                            <option value="@fam.Id" selected="@(Model.FamiliaId == fam.Id)">
                                @fam.ApellidoTitular, @fam.NombreTitular (DNI: @fam.DniTitular) - @fam.CantidadIntegrantes @(fam.CantidadIntegrantes == 1 ? "integrante" : "integrantes")
                            </option>
                        }
                    </select>
                    <span asp-validation-for="FamiliaId" class="text-danger small"></span>
                </div>

                <div class="col-lg-6 col-md-5">
                    <label asp-for="TipoPaqueteId" class="form-label fw-semibold">Kit nutricional (calculado por integrantes)</label>
                    <select asp-for="TipoPaqueteId" class="form-select" id="comboKit">
                        <option value=""> Automático por tamaño familiar </option>
                        @foreach (var kit in tiposPaquete)
                        {
                            <option value="@kit.Id" selected="@(Model.TipoPaqueteId == kit.Id)">
                                @kit.Nombre (@kit.MinIntegrantes a @kit.MaxIntegrantes integrantes)
                            </option>
                        }
                    </select>
                    <span asp-validation-for="TipoPaqueteId" class="text-danger small"></span>
                </div>
            </div>

            <!-- Spinner de carga reactiva -->
            <div id="spinnerCargando" class="text-center py-3 d-none">
                <div class="spinner-border spinner-border-sm text-success me-2" role="status"></div>
                <span class="text-muted small">Consultando receta y verificando lotes disponibles</span>
            </div>

            <!-- Alerta de Error Dinámica -->
            <div id="alertaErrorDinamica" class="alert alert-danger border-start border-4 border-danger d-none mt-3 mb-0" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                <span id="mensajeErrorDinamico"></span>
            </div>

            <!-- Ficha Resumen de Familia y Kit -->
            <div id="cardResumenFamilia" class="mt-4 p-3 bg-light bg-opacity-50 rounded-4 border @(tienePropuestaInicial ? "" : "d-none")">
                <div class="row g-2 align-items-center">
                    <div class="col-md-4">
                        <small class="text-muted d-block fw-semibold">Titular beneficiario:</small>
                        <strong class="text-dark" id="txtResumenTitular">@(Model.Propuesta?.FamiliaTitular)</strong>
                        <div class="text-secondary small font-mono" id="txtResumenDni">DNI: @(Model.Propuesta?.DniTitular)</div>
                    </div>
                    <div class="col-md-4">
                        <small class="text-muted d-block fw-semibold">Composición del hogar:</small>
                        <span class="badge bg-secondary bg-opacity-10 text-secondary rounded-pill px-3 py-1" id="txtResumenIntegrantes">
                            <i class="bi bi-people me-1"></i>@(Model.Propuesta?.CantidadIntegrantes) personas
                        </span>
                    </div>
                    <div class="col-md-4">
                        <small class="text-muted d-block fw-semibold">Plantilla aplicada:</small>
                        <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-1" id="txtResumenKit">
                            <i class="bi bi-check-circle me-1"></i>@(Model.Propuesta?.TipoPaqueteNombre)
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- PASO 2: RECETA, LOTES FEFO Y CONFIRMACIÓN -->
    <div id="contenedorPropuesta" class="@(tienePropuestaInicial ? "" : "d-none")">
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white mb-4">
            <div class="card-header border-bottom p-3 px-4 bg-white d-flex align-items-center justify-content-between">
                <span class="fw-bold text-dark fs-6">
                    <i class="bi bi-boxes text-success me-2"></i>2. Asignación Automática y Sustituciones
                </span>
                <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-1">Control de existencias</span>
            </div>
            <div class="card-body p-4">

                <!-- Alerta de Stock Completo -->
                <div id="alertaCompleto" class="alert alert-success border-start border-4 border-success d-flex align-items-center mb-4 shadow-sm rounded-3 @(tienePropuestaInicial && !Model.Propuesta!.HayFaltantes ? "" : "d-none")" role="alert">
                    <i class="bi bi-check-circle-fill fs-3 text-success me-3"></i>
                    <div>
                        <strong>Inventario completo y óptimo</strong>
                        <div>
                            Se verificó la disponibilidad de todos los alimentos de la plantilla. Los lotes fueron seleccionados automáticamente priorizando las fechas de caducidad más próximas.
                        </div>
                    </div>
                </div>

                <!-- Alerta de Faltantes -->
                <div id="alertaFaltantes" class="alert alert-warning border-start border-4 border-warning d-flex align-items-center mb-4 shadow-sm rounded-3 @(tienePropuestaInicial && Model.Propuesta!.HayFaltantes ? "" : "d-none")" role="alert">
                    <i class="bi bi-exclamation-triangle-fill fs-3 text-warning me-3"></i>
                    <div>
                        <strong>Alerta de faltantes de inventario</strong>
                        <div>
                            No hay suficiente stock en los lotes activos para completar todos los alimentos de la receta estándar.
                            Puede optar por confirmar el paquete con faltante o aplicar una <strong>sustitución supervisada</strong> en la columna derecha.
                        </div>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light text-secondary small text-uppercase">
                            <tr>
                                <th class="ps-3">Alimento de la receta</th>
                                <th class="text-center">Requerido</th>
                                <th class="text-center">Disponible</th>
                                <th>Lotes reservados</th>
                                <th>Estado cobertura</th>
                                <th class="pe-3">Sustitución supervisada</th>
                            </tr>
                        </thead>
                        <tbody id="cuerpoTablaPropuesta">
                            @if (tienePropuestaInicial)
                            {
                                for (int i = 0; i < Model.Propuesta!.Items.Count; i++)
                                {
                                    var item = Model.Propuesta.Items[i];
                                    <tr>
                                        <input type="hidden" name="Items.Index" value="@i" />
                                        <input type="hidden" name="Items[@i].ProductoId" id="prodId_@i" value="@item.ProductoId" />
                                        <input type="hidden" name="Items[@i].NombreProducto" id="prodNombre_@i" value="@item.NombreProducto" />
                                        <input type="hidden" name="Items[@i].CodigoBarras" value="@item.CodigoBarras" />
                                        <input type="hidden" name="Items[@i].Cantidad" value="@item.CantidadRequerida" />
                                        <input type="hidden" name="Items[@i].EsSustituto" id="esSustituto_@i" value="false" />
                                        <input type="hidden" name="Items[@i].ProductoSustituidoId" id="prodSustituidoId_@i" value="" />

                                        <td class="ps-3">
                                            <div class="fw-bold text-dark" id="displayNombre_@i">@item.NombreProducto</div>
                                            <small class="text-muted font-mono">EAN: @item.CodigoBarras</small>
                                        </td>
                                        <td class="text-center fw-bold fs-6 font-mono">
                                            @item.CantidadRequerida.ToString("N0")
                                        </td>
                                        <td class="text-center fw-bold @(item.CubiertoTotalmente ? "text-success" : "text-danger") fs-6 font-mono">
                                            @item.CantidadDisponible.ToString("N0")
                                        </td>
                                        <td>
                                            @if (item.LotesAsignados.Any())
                                            {
                                                <div class="d-flex flex-wrap gap-1">
                                                    @foreach (var lote in item.LotesAsignados)
                                                    {
                                                        <span class="badge bg-light text-dark border font-mono small rounded-pill px-2 py-1" title="Vence @lote.FechaVencimiento.ToString("dd/MM/yyyy")">
                                                            @lote.NumeroLote (@lote.CantidadAsignada.ToString("N0") u.)
                                                        </span>
                                                    }
                                                </div>
                                            }
                                            else
                                            {
                                                <span class="text-muted small fst-italic">Sin existencias disponibles</span>
                                            }
                                        </td>
                                        <td>
                                            @if (item.CubiertoTotalmente)
                                            {
                                                <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-1">
                                                    <i class="bi bi-check-all me-1"></i> 100% Cubierto
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger bg-opacity-10 text-danger rounded-pill px-3 py-1">
                                                    <i class="bi bi-exclamation-octagon me-1"></i> Falta @item.Faltante.ToString("N0") u.
                                                </span>
                                            }
                                        </td>
                                        <td class="pe-3">
                                            <div class="input-group input-group-sm" style="max-width: 280px;">
                                                <select class="form-select select-sustituto" data-index="@i" data-original-id="@item.ProductoId" data-original-nombre="@item.NombreProducto">
                                                    <option value="">-- Sin sustitución --</option>
                                                    @foreach (var alt in productosCatalogo.Where(p => p.Id != item.ProductoId))
                                                    {
                                                        <option value="@alt.Id">Sustituir por: @alt.Nombre</option>
                                                    }
                                                </select>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Datos del Armador y Observaciones -->
                <div class="row g-3 mt-4 pt-3 border-top">
                    <div class="col-md-4">
                        <label asp-for="UsuarioArmadorId" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-success border-end-0"><i class="bi bi-person-check-fill"></i></span>
                            <input asp-for="UsuarioArmadorId" class="form-control bg-light text-dark fw-semibold border-start-0" readonly />
                        </div>
                        <small class="text-muted d-block mt-1" style="font-size: 0.75rem;">
                            <i class="bi bi-shield-lock-fill text-secondary me-1"></i>Asignado al usuario en sesión
                        </small>
                    </div>
                    <div class="col-md-8">
                        <label asp-for="Observaciones" class="form-label fw-semibold"></label>
                        <input asp-for="Observaciones" class="form-control" placeholder="Ej: Se sustituyó arroz por fideos por rotura de stock en depósito" />
                    </div>
                </div>

                <!-- Botón Principal de Confirmación -->
                <div class="text-end mt-4 pt-2">
                    <button type="submit" id="btnConfirmarArmado" class="btn btn-success rounded-pill btn-lg px-5 fw-semibold shadow-sm">
                        <i class="bi bi-check2-circle me-2"></i> Confirmar Armado y Generar Rótulo QR
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Placeholder cuando aún no se ha seleccionado familia -->
    <div id="placeholderSinFamilia" class="card border-0 shadow-sm rounded-4 text-center py-5 bg-white mb-4 @(tienePropuestaInicial ? "d-none" : "")">
        <div class="card-body">
            <i class="bi bi-person-check fs-1 text-secondary opacity-50 d-block mb-3"></i>
            <h5 class="fw-bold text-dark">Selecciona una familia beneficiaria</h5>
            <p class="text-muted mx-auto" style="max-width: 520px;">
                Al seleccionar una familia del listado superior, el sistema determinará automáticamente el kit nutricional correspondiente y calculará de inmediato la rotación de lotes.
            </p>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        // Catálogo de productos para selectores dinámicos de sustitutos
        const catalogoProductos = [
            @foreach (var prod in productosCatalogo)
            {
                <text>{ id: @prod.Id, nombre: "@Html.Raw(prod.Nombre.Replace("\"", "\\\""))" },</text>
            }
        ];

        document.addEventListener("DOMContentLoaded", function () {
            const comboFamilia = document.getElementById("comboFamilia");
            const comboKit = document.getElementById("comboKit");
            const spinnerCargando = document.getElementById("spinnerCargando");
            const alertaErrorDinamica = document.getElementById("alertaErrorDinamica");
            const mensajeErrorDinamico = document.getElementById("mensajeErrorDinamico");
            const cardResumenFamilia = document.getElementById("cardResumenFamilia");
            const txtResumenTitular = document.getElementById("txtResumenTitular");
            const txtResumenDni = document.getElementById("txtResumenDni");
            const txtResumenIntegrantes = document.getElementById("txtResumenIntegrantes");
            const txtResumenKit = document.getElementById("txtResumenKit");

            const contenedorPropuesta = document.getElementById("contenedorPropuesta");
            const placeholderSinFamilia = document.getElementById("placeholderSinFamilia");
            const cuerpoTablaPropuesta = document.getElementById("cuerpoTablaPropuesta");
            const alertaCompleto = document.getElementById("alertaCompleto");
            const alertaFaltantes = document.getElementById("alertaFaltantes");

            // Función para vincular eventos a selectores de sustitución
            function vincularSustitutos() {
                document.querySelectorAll(".select-sustituto").forEach(select => {
                    select.removeEventListener("change", manejarCambioSustituto);
                    select.addEventListener("change", manejarCambioSustituto);
                });
            }

            function manejarCambioSustituto() {
                const idx = this.getAttribute("data-index");
                const origId = this.getAttribute("data-original-id");
                const origNombre = this.getAttribute("data-original-nombre");

                const prodIdInput = document.getElementById("prodId_" + idx);
                const prodNombreInput = document.getElementById("prodNombre_" + idx);
                const esSustitutoInput = document.getElementById("esSustituto_" + idx);
                const prodSustituidoIdInput = document.getElementById("prodSustituidoId_" + idx);
                const displayNombre = document.getElementById("displayNombre_" + idx);

                if (this.value) {
                    const nuevoId = this.value;
                    const nuevoNombre = this.options[this.selectedIndex].text.replace("Sustituir por: ", "");

                    prodIdInput.value = nuevoId;
                    prodNombreInput.value = nuevoNombre;
                    esSustitutoInput.value = "true";
                    prodSustituidoIdInput.value = origId;

                    displayNombre.innerHTML = `${nuevoNombre} <span class="badge bg-warning text-dark ms-1">Sustituto de ${origNombre}</span>`;
                } else {
                    prodIdInput.value = origId;
                    prodNombreInput.value = origNombre;
                    esSustitutoInput.value = "false";
                    prodSustituidoIdInput.value = "";

                    displayNombre.textContent = origNombre;
                }
            }

            vincularSustitutos();

            function actualizarWizard(paso) {
                const icon1 = document.getElementById("wizardIcono1");
                const paso2 = document.getElementById("wizardPaso2");
                const icon2 = document.getElementById("wizardIcono2");
                const txt2 = document.getElementById("wizardTexto2");
                const paso3 = document.getElementById("wizardPaso3");
                const icon3 = document.getElementById("wizardIcono3");
                const txt3 = document.getElementById("wizardTexto3");

                if (paso === 1) {
                    if (icon1) icon1.innerHTML = '<i class="bi bi-person-check fs-5"></i>';
                    if (paso2) paso2.classList.add("opacity-50");
                    if (icon2) { icon2.style.background = "#e2e8f0"; icon2.style.color = "#475569"; }
                    if (txt2) { txt2.classList.remove("text-dark"); txt2.classList.add("text-secondary"); }
                    if (paso3) paso3.classList.add("opacity-50");
                    if (icon3) { icon3.style.background = "#e2e8f0"; icon3.style.color = "#475569"; }
                    if (txt3) { txt3.classList.remove("text-primary"); txt3.classList.add("text-secondary"); }
                } else if (paso >= 2) {
                    if (icon1) icon1.innerHTML = '<i class="bi bi-check-lg fs-5"></i>';
                    if (paso2) paso2.classList.remove("opacity-50");
                    if (icon2) { icon2.style.background = "#059669"; icon2.style.color = "#ffffff"; }
                    if (txt2) { txt2.classList.remove("text-secondary"); txt2.classList.add("text-dark"); }
                    if (paso3) paso3.classList.remove("opacity-50");
                    if (icon3) { icon3.style.background = "#eff6ff"; icon3.style.color = "#2563eb"; }
                    if (txt3) { txt3.classList.remove("text-secondary"); txt3.classList.add("text-primary"); }
                }
            }

            // Carga Reactiva Instantánea al seleccionar Familia o Kit
            async function cargarPropuestaReactiva() {
                const famId = comboFamilia.value;
                const kitId = comboKit.value;

                alertaErrorDinamica.classList.add("d-none");

                if (!famId) {
                    cardResumenFamilia.classList.add("d-none");
                    contenedorPropuesta.classList.add("d-none");
                    placeholderSinFamilia.classList.remove("d-none");
                    cuerpoTablaPropuesta.innerHTML = "";
                    actualizarWizard(1);
                    return;
                }

                spinnerCargando.classList.remove("d-none");

                try {
                    let url = `@Url.Action("ObtenerPropuestaJson", "Paquetes")?familiaId=${famId}`;
                    if (kitId) {
                        url += `&tipoPaqueteId=${kitId}`;
                    }

                    const response = await fetch(url);
                    const data = await response.json();

                    spinnerCargando.classList.add("d-none");

                    if (!data.success || !data.data) {
                        alertaErrorDinamica.classList.remove("d-none");
                        mensajeErrorDinamico.textContent = data.errorMessage || "No se pudo obtener la propuesta de kit.";
                        contenedorPropuesta.classList.add("d-none");
                        cardResumenFamilia.classList.add("d-none");
                        placeholderSinFamilia.classList.remove("d-none");
                        actualizarWizard(1);
                        return;
                    }

                    const prop = data.data;
                    actualizarWizard(2);

                    // 1. Sincronizar Ficha Resumen
                    txtResumenTitular.textContent = prop.familiaTitular;
                    txtResumenDni.textContent = `DNI: ${prop.dniTitular}`;
                    txtResumenIntegrantes.innerHTML = `<i class="bi bi-people me-1"></i>${prop.cantidadIntegrantes} personas`;
                    txtResumenKit.innerHTML = `<i class="bi bi-check-circle me-1"></i>${prop.tipoPaqueteNombre}`;
                    cardResumenFamilia.classList.remove("d-none");

                    // 2. Sincronizar el combo de kit con el asignado
                    comboKit.value = prop.tipoPaqueteId;

                    // 3. Renderizar Alertas de Cobertura
                    if (prop.hayFaltantes) {
                        alertaFaltantes.classList.remove("d-none");
                        alertaCompleto.classList.add("d-none");
                    } else {
                        alertaCompleto.classList.remove("d-none");
                        alertaFaltantes.classList.add("d-none");
                    }

                    // 4. Renderizar Filas de Alimentos
                    cuerpoTablaPropuesta.innerHTML = "";

                    prop.items.forEach((item, i) => {
                        let lotesHtml = "";
                        if (item.lotesAsignados && item.lotesAsignados.length > 0) {
                            lotesHtml = '<div class="d-flex flex-wrap gap-1">';
                            item.lotesAsignados.forEach(l => {
                                const fv = new Date(l.fechaVencimiento);
                                const fvStr = `${String(fv.getDate()).padStart(2, '0')}/${String(fv.getMonth() + 1).padStart(2, '0')}/${fv.getFullYear()}`;
                                lotesHtml += `<span class="badge bg-light text-dark border font-mono small rounded-pill px-2 py-1" title="Vence ${fvStr}">
                                    ${l.numeroLote} (${Math.round(l.cantidadAsignada)} u.)
                                </span>`;
                            });
                            lotesHtml += '</div>';
                        } else {
                            lotesHtml = '<span class="text-muted small fst-italic">Sin existencias disponibles</span>';
                        }

                        let badgeCobertura = "";
                        if (item.cubiertoTotalmente) {
                            badgeCobertura = `<span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-1">
                                <i class="bi bi-check-all me-1"></i> 100% Cubierto
                            </span>`;
                        } else {
                            badgeCobertura = `<span class="badge bg-danger bg-opacity-10 text-danger rounded-pill px-3 py-1">
                                <i class="bi bi-exclamation-octagon me-1"></i> Falta ${Math.round(item.faltante)} u.
                            </span>`;
                        }

                        let opcionesSustitutos = '<option value="">-- Sin sustitución --</option>';
                        catalogoProductos.forEach(p => {
                            if (p.id !== item.productoId) {
                                opcionesSustitutos += `<option value="${p.id}">Sustituir por: ${p.nombre}</option>`;
                            }
                        });

                        const tr = document.createElement("tr");
                        tr.innerHTML = `
                            <input type="hidden" name="Items.Index" value="${i}" />
                            <input type="hidden" name="Items[${i}].ProductoId" id="prodId_${i}" value="${item.productoId}" />
                            <input type="hidden" name="Items[${i}].NombreProducto" id="prodNombre_${i}" value="${item.nombreProducto}" />
                            <input type="hidden" name="Items[${i}].CodigoBarras" value="${item.codigoBarras}" />
                            <input type="hidden" name="Items[${i}].Cantidad" value="${item.cantidadRequerida}" />
                            <input type="hidden" name="Items[${i}].EsSustituto" id="esSustituto_${i}" value="false" />
                            <input type="hidden" name="Items[${i}].ProductoSustituidoId" id="prodSustituidoId_${i}" value="" />

                            <td>
                                <div class="fw-bold text-dark" id="displayNombre_${i}">${item.nombreProducto}</div>
                                <small class="text-muted font-mono">EAN: ${item.codigoBarras}</small>
                            </td>
                            <td class="text-center fw-bold fs-6">
                                ${Math.round(item.cantidadRequerida)}
                            </td>
                            <td class="text-center fw-bold ${item.cubiertoTotalmente ? 'text-success' : 'text-danger'} fs-6">
                                ${Math.round(item.cantidadDisponible)}
                            </td>
                            <td>${lotesHtml}</td>
                            <td>${badgeCobertura}</td>
                            <td>
                                <div class="input-group input-group-sm" style="max-width: 280px;">
                                    <select class="form-select select-sustituto" data-index="${i}" data-original-id="${item.productoId}" data-original-nombre="${item.nombreProducto}">
                                        ${opcionesSustitutos}
                                    </select>
                                </div>
                            </td>
                        `;
                        cuerpoTablaPropuesta.appendChild(tr);
                    });

                    vincularSustitutos();
                    contenedorPropuesta.classList.remove("d-none");
                    placeholderSinFamilia.classList.add("d-none");

                } catch (err) {
                    spinnerCargando.classList.add("d-none");
                    alertaErrorDinamica.classList.remove("d-none");
                    mensajeErrorDinamico.textContent = "Ocurrió un error de red al consultar el kit para la familia.";
                }
            }

            comboFamilia.addEventListener("change", cargarPropuestaReactiva);
            comboKit.addEventListener("change", cargarPropuestaReactiva);
        });
    </script>
}
