@model NutriRed.Web.Models.TrazabilidadFiltroViewModel
@{
    ViewData["Title"] = "Módulo de Trazabilidad";
}

<!-- Encabezado -->
<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h2 class="fw-bold text-dark mb-1">
            <i class="bi bi-diagram-3-fill text-success me-2"></i>Módulo de Trazabilidad
        </h2>
        <p class="text-muted mb-0">Rastrea la cadena de custodia completa de los alimentos desde el donante hasta la familia receptora.</p>
    </div>
</div>

<!-- Panel Avanzado de Filtros y Búsqueda -->
<form method="get" asp-action="Index" class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-white">
    <div class="row g-3">
        <!-- Fila 1: Búsqueda General -->
        <div class="col-12 col-lg-6">
            <label class="form-label small fw-semibold text-secondary mb-1">
                <i class="bi bi-search me-1"></i>Búsqueda por texto libre
            </label>
            <div class="input-group">
                <span class="input-group-text bg-light border-end-0 rounded-start-3 text-muted"><i class="bi bi-qr-code-scan"></i></span>
                <input type="text" id="inputBusqueda" name="busqueda" value="@Model.Busqueda"
                       class="form-control bg-light border-start-0 rounded-end-3"
                       placeholder="Escriba para autocompletar (ej: gonz, PKG, Lote...)"
                       list="sugerenciasList" autocomplete="off" />

                <datalist id="sugerenciasList"></datalist>
            </div>
        </div>

        <!-- Donante Desplegable -->
        <div class="col-12 col-md-6 col-lg-3">
            <label class="form-label small fw-semibold text-secondary mb-1">
                <i class="bi bi-building me-1"></i>Filtrar por Donante
            </label>
            <select name="donanteId" class="form-select rounded-3">
                <option value="">-- Todos los Donantes --</option>
                @foreach (var item in Model.Donantes)
                {
                    <option value="@item.Value" selected="@(item.Value == Model.DonanteId?.ToString())">@item.Text</option>
                }
            </select>
        </div>

        <!-- Tipo de Kit Desplegable -->
        <div class="col-12 col-md-6 col-lg-3">
            <label class="form-label small fw-semibold text-secondary mb-1">
                <i class="bi bi-box me-1"></i>Tipo de Kit Nutricional
            </label>
            <select name="tipoPaqueteId" class="form-select rounded-3">
                <option value="">-- Todos los Kits --</option>
                @foreach (var item in Model.TiposPaquete)
                {
                    <option value="@item.Value" selected="@(item.Value == Model.TipoPaqueteId?.ToString())">@item.Text</option>
                }
            </select>
        </div>

        <!-- Fila 2: Fechas y Botones -->
        <div class="col-12 col-md-4 col-lg-3">
            <label class="form-label small fw-semibold text-secondary mb-1"><i class="bi bi-calendar-event me-1"></i>Fecha Entrega Desde</label>
            <input type="date" name="fechaDesde" value="@(Model.FechaDesde?.ToString("yyyy-MM-dd"))" class="form-control rounded-3" />
        </div>

        <div class="col-12 col-md-4 col-lg-3">
            <label class="form-label small fw-semibold text-secondary mb-1"><i class="bi bi-calendar-event me-1"></i>Fecha Entrega Hasta</label>
            <input type="date" name="fechaHasta" value="@(Model.FechaHasta?.ToString("yyyy-MM-dd"))" class="form-control rounded-3" />
        </div>

        <div class="col-12 col-md-4 col-lg-6 d-flex align-items-end gap-2">
            <button type="submit" class="btn btn-success rounded-3 fw-semibold flex-fill py-2">
                <i class="bi bi-funnel-fill me-1"></i>Aplicar Filtros
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary rounded-3 fw-semibold py-2" title="Limpiar Filtros">
                <i class="bi bi-arrow-counterclockwise me-1"></i>Limpiar
            </a>
        </div>
    </div>
</form>

<!-- Resultados de Trazabilidad -->
@if (Model.EntregasGrouped != null && Model.EntregasGrouped.Any())
{
    <div class="d-flex align-items-center justify-content-between mb-3 px-1">
        <span class="text-muted small">Se encontraron <strong>@Model.EntregasGrouped.Count</strong> entregas registradas en la trazabilidad.</span>
    </div>

    @foreach (var entrega in Model.EntregasGrouped)
    {
        <div class="card border-0 shadow-sm rounded-4 mb-4 bg-white overflow-hidden">
            <!-- Header de Entrega -->
            <div class="card-header bg-light border-0 py-3 px-4 d-flex flex-wrap justify-content-between align-items-center gap-2">
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-primary fs-6 px-3 py-2 font-monospace">
                        <i class="bi bi-box-seam me-1"></i>@entrega.CodigoPaquete
                    </span>
                    <span class="badge bg-light text-dark border px-3 py-2">
                        Tipo: <strong>@entrega.TipoPaquete</strong>
                    </span>
                </div>
                <div>
                    <span class="badge bg-success bg-opacity-10 text-success border border-success-subtle px-3 py-2">
                        <i class="bi bi-calendar-check me-1"></i>Entregado el @entrega.FechaEntrega.ToString("dd/MM/yyyy HH:mm")
                    </span>
                </div>
            </div>

            <div class="card-body p-4">
                <!-- Información Receptores -->
                <div class="row g-3 mb-4 pb-3 border-bottom">
                    <div class="col-md-6">
                        <div class="d-flex align-items-center gap-2 text-warning mb-1">
                            <i class="bi bi-people-fill fs-5"></i>
                            <span class="fw-bold text-dark">Familia Beneficiaria</span>
                        </div>
                        <div class="fw-semibold text-dark fs-6">@entrega.NombreFamilia</div>
                        <small class="text-muted d-block"><i class="bi bi-card-heading me-1"></i>DNI Titular: @entrega.DniRepresentante</small>
                        <small class="text-muted d-block"><i class="bi bi-geo-alt me-1"></i>Dirección: @entrega.DireccionFamilia</small>
                    </div>

                    <div class="col-md-6">
                        <div class="d-flex align-items-center gap-2 text-info mb-1">
                            <i class="bi bi-person-badge-fill fs-5"></i>
                            <span class="fw-bold text-dark">Voluntario Despachador</span>
                        </div>
                        <div class="fw-semibold text-dark fs-6">@entrega.VoluntarioNombre</div>
                        <small class="text-muted d-block"><i class="bi bi-person me-1"></i>Usuario: @entrega.VoluntarioUserName</small>
                    </div>
                </div>

                <!-- Lista de Lotes y Donantes -->
                <h6 class="fw-bold text-dark mb-3">
                    <i class="bi bi-list-check me-2 text-success"></i>Composición e Historial de Origen (Donantes)
                </h6>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 border rounded-3">
                        <thead class="table-light">
                            <tr>
                                <th>Alimento / Producto</th>
                                <th>Lote NutriRed</th>
                                <th>Vencimiento</th>
                                <th>Cantidad</th>
                                <th>Donante de Origen</th>
                                <th>Fecha Donación</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in entrega.Items)
                            {
                                <tr>
                                    <td class="fw-semibold text-dark">@item.NombreProducto</td>
                                    <td><span class="badge bg-secondary font-monospace">@item.NumeroLote</span></td>
                                    <td>@(item.FechaVencimiento.HasValue? item.FechaVencimiento.Value.ToString("dd/MM/yyyy") : "-")</td>
                                    <td><strong>@item.Cantidad.ToString("N0")</strong> @item.UnidadMedida</td>
                                    <td>
                                        <div class="fw-semibold text-success">@item.NombreDonante</div>
                                        <small class="text-muted">Doc: @item.DocumentoDonante</small>
                                    </td>
                                    <td>@(item.FechaDonacion != DateTime.MinValue ? item.FechaDonacion.ToString("dd/MM/yyyy") : "-")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
}
else
{
    <div class="card border-0 shadow-sm rounded-4 p-5 text-center bg-white">
        <i class="bi bi-search-heart fs-1 text-muted opacity-50 mb-3"></i>
        <h5 class="fw-bold text-dark">Sin registros para los criterios seleccionados</h5>
        <p class="text-muted small mb-0">Utilice la barra de búsqueda o seleccione un donante/tipo de kit en los desplegables superiores para explorar la trazabilidad.</p>
    </div>
}

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const inputBusqueda = document.getElementById("inputBusqueda");
            const datalist = document.getElementById("sugerenciasList");
            let timeout = null;

            if (inputBusqueda && datalist) {
                inputBusqueda.addEventListener("input", function () {
                    const query = this.value.trim();

                    clearTimeout(timeout);

                    if (query.length < 2) {
                        datalist.innerHTML = "";
                        return;
                    }

                    // Espera 300ms después de que el usuario deja de teclear
                    timeout = setTimeout(() => {
                        fetch(`/Trazabilidad/BuscarSugerencias?term=${encodeURIComponent(query)}`)
                            .then(response => response.json())
                            .then(data => {
                                datalist.innerHTML = "";
                                data.forEach(item => {
                                    const option = document.createElement("option");
                                    option.value = item;
                                    datalist.appendChild(option);
                                });
                            })
                            .catch(err => console.error("Error al obtener sugerencias:", err));
                    }, 300);
                });
            }
        });
    </script>
}