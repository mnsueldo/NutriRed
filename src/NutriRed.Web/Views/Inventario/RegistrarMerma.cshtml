@model NutriRed.Web.Models.RegistrarMermaViewModel
@{
    ViewData["Title"] = "Registro de mermas & bajas";
}

<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
<link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" rel="stylesheet" />

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3">
                <div class="d-flex align-items-center">
                    <div class="rounded-circle bg-danger bg-opacity-10 p-3 me-3">
                        <i class="bi bi-trash3-fill fs-3 text-danger"></i>
                    </div>
                    <div>
                        <h4 class="card-title fw-bold text-dark mb-0">Registro de mermas & bajas</h4>
                        <small class="text-muted">Descarte de alimentos por vencimiento, deterioro o rotura de envase.</small>
                    </div>
                </div>
            </div>
            <div class="card-body p-4">
                <form asp-action="RegistrarMerma" method="post">
                    <partial name="_Alertas" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <!-- Paso 1: Selección / Búsqueda del Producto por Nombre o Código de Barras -->
                    <div class="mb-3">
                        <label asp-for="ProductoId" class="form-label fw-semibold">1. Buscar alimento</label>
                        <select asp-for="ProductoId" asp-items="ViewBag.ProductosSelectList" class="form-select select2-search" id="cboProducto">
                            <option value=""> Escriba el nombre o código de barras </option>
                        </select>
                        <span asp-validation-for="ProductoId" class="text-danger small"></span>
                    </div>

                    <!-- Paso 2: Selección de Lote Específico del Producto Elegido -->
                    <div class="mb-3">
                        <label asp-for="LoteId" class="form-label fw-semibold">2. Seleccionar lote afectado</label>
                        <select asp-for="LoteId" asp-items="ViewBag.LotesSelectList" class="form-select" id="cboLote" disabled="@(Model?.ProductoId == null)">
                            <option value=""> Primero seleccione un alimento </option>
                        </select>
                        <span asp-validation-for="LoteId" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <!-- Cantidad -->
                        <div class="col-md-6 mb-3">
                            <label asp-for="Cantidad" class="form-label fw-semibold text-dark">Cantidad a dar de baja</label>
                            <input asp-for="Cantidad"
                                   type="number"
                                   class="form-control"
                                   min="0.01"
                                   step="0.01"
                                   placeholder="Ej: 5 o 1.5" />
                            <span asp-validation-for="Cantidad" class="text-danger small"></span>
                        </div>

                        <!-- Motivo de la Merma -->
                        <div class="col-md-6">
                            <label asp-for="Motivo" class="form-label fw-semibold"></label>
                            <select asp-for="Motivo" asp-items="ViewBag.MotivosSelectList" class="form-select">
                                <option value=""> Seleccione motivo </option>
                            </select>
                            <span asp-validation-for="Motivo" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- Observaciones -->
                    <div class="mb-4">
                        <label asp-for="Observaciones" class="form-label fw-semibold"></label>
                        <textarea asp-for="Observaciones" class="form-control" rows="3" placeholder="Indique detalles adicionales de la baja (ej: envase dañado en traslado, abolladura grave, fecha expirada en estantería)"></textarea>
                        <span asp-validation-for="Observaciones" class="text-danger small"></span>
                    </div>

                    <!-- Acciones del Formulario -->
                    <div class="d-flex justify-content-between pt-2">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left"></i> Volver a inventario
                        </a>
                        <button type="submit" class="btn btn-danger">
                            <i class="bi bi-check-circle"></i> Confirmar baja de stock
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script>
        $(document).ready(function () {
            // Inicializar Select2 para búsqueda rápida en el combo de Producto
            $('#cboProducto').select2({
                theme: 'bootstrap-5',
                placeholder: ' Escriba el nombre o código de barras (EAN) ',
                allowClear: true,
                width: '100%'
            });

            // Evento al cambiar de Producto
            $('#cboProducto').on('change', function () {
                var productoId = $(this).val();
                var $cboLote = $('#cboLote');

                $cboLote.empty();

                if (!productoId) {
                    $cboLote.append('<option value=""> Primero seleccione un producto </option>');
                    $cboLote.prop('disabled', true);
                    return;
                }

                $cboLote.append('<option value="">Cargando lotes disponibles</option>');
                $cboLote.prop('disabled', true);

                // Fetch AJAX para traer los lotes filtrados por ProductoId
                fetch('/Inventario/ObtenerLotesPorProducto?productoId=' + productoId)
                    .then(response => response.json())
                    .then(data => {
                        $cboLote.empty();
                        if (data.length === 0) {
                            $cboLote.append('<option value=""> No hay lotes con stock para este producto </option>');
                            $cboLote.prop('disabled', true);
                        } else {
                            $cboLote.append('<option value=""> Seleccione el lote afectado </option>');
                            data.forEach(function (lote) {
                                $cboLote.append(new Option(lote.texto, lote.id));
                            });
                            $cboLote.prop('disabled', false);
                        }
                    })
                    .catch(error => {
                        console.error('Error al cargar lotes:', error);
                        $cboLote.empty();
                        $cboLote.append('<option value="">Error al cargar los lotes</option>');
                    });
            });
        });
    </script>
}