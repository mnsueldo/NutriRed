@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@model IEnumerable<NutriRed.Services.DTOs.StockProductoDto>
@{
    ViewData["Title"] = "Stock Consolidado & Semáforo FEFO";

    // Métricas de resumen calculadas automáticamente
    var totalProductos = Model.Count();
    var stockTotal = Model.Sum(x => x.StockActual);
    var productosEnAlerta = Model.Count(x => x.ProximoVencimiento.HasValue &&
        (x.ProximoVencimiento.Value.Date - DateTime.Today).Days > 0 &&
        (x.ProximoVencimiento.Value.Date - DateTime.Today).Days <= 15);
    var productosVencidos = Model.Count(x => x.ProximoVencimiento.HasValue &&
        (x.ProximoVencimiento.Value.Date - DateTime.Today).Days <= 0);
}

<!-- Encabezado Principal -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h2 class="fw-bold mb-1 text-dark">
            <i class="bi bi-boxes text-success me-2"></i>Stock de Alimentos & FEFO
        </h2>
        <p class="text-secondary mb-0">Gestión de existencias consolidadas, semáforos de rotación First Expired, First Out y auditoría de almacén.</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a asp-action="RegistrarMerma" class="btn btn-outline-danger rounded-pill shadow-sm px-3 fw-semibold">
            <i class="bi bi-trash3-fill me-1"></i> Registrar Merma / Baja
        </a>
        <a asp-controller="Donaciones" asp-action="Registrar" class="btn btn-success rounded-pill shadow-sm px-3 fw-semibold">
            <i class="bi bi-plus-circle-fill me-1"></i> Ingreso por Donación
        </a>
    </div>
</div>

<!-- Panel de Métricas / KPIs Rápidos -->
<div class="row g-3 mb-4">
    <!-- 1. Total Alimentos -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-circle bg-success bg-opacity-10 p-3 text-success d-flex align-items-center justify-content-center" style="width: 52px; height: 52px;">
                    <i class="bi bi-box-seam-fill fs-4"></i>
                </div>
                <div>
                    <span class="text-muted small fw-semibold text-uppercase d-block">Total Alimentos</span>
                    <span class="fs-4 fw-bold text-dark">@totalProductos</span>
                    <small class="text-muted d-block" style="font-size: 0.72rem;">Artículos en catálogo</small>
                </div>
            </div>
        </div>
    </div>

    <!-- 2. Stock Disponible Total -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-circle bg-primary bg-opacity-10 p-3 text-primary d-flex align-items-center justify-content-center" style="width: 52px; height: 52px;">
                    <i class="bi bi-archive-fill fs-4"></i>
                </div>
                <div>
                    <span class="text-muted small fw-semibold text-uppercase d-block">Stock Disponible</span>
                    <span class="fs-4 fw-bold text-dark">@stockTotal.ToString("N0") <span class="fs-6 text-muted fw-normal">u/kg/L</span></span>
                    <small class="text-muted d-block" style="font-size: 0.72rem;">Existencias físicas aptas</small>
                </div>
            </div>
        </div>
    </div>

    <!-- 3. Alerta por Vencimiento Próximo -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-circle bg-warning bg-opacity-10 p-3 text-warning d-flex align-items-center justify-content-center" style="width: 52px; height: 52px;">
                    <i class="bi bi-exclamation-triangle-fill fs-4"></i>
                </div>
                <div>
                    <span class="text-muted small fw-semibold text-uppercase d-block">En Alerta FEFO</span>
                    <span class="fs-4 fw-bold text-warning-emphasis">@productosEnAlerta</span>
                    <small class="text-muted d-block" style="font-size: 0.72rem;">Vencimiento en ≤ 15 días</small>
                </div>
            </div>
        </div>
    </div>

    <!-- 4. Críticos o Vencidos -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-circle bg-danger bg-opacity-10 p-3 text-danger d-flex align-items-center justify-content-center" style="width: 52px; height: 52px;">
                    <i class="bi bi-shield-x fs-4"></i>
                </div>
                <div>
                    <span class="text-muted small fw-semibold text-uppercase d-block">Lotes Vencidos</span>
                    <span class="fs-4 fw-bold text-danger">@productosVencidos</span>
                    <small class="text-muted d-block" style="font-size: 0.72rem;">Gestionar, dar de baja</small>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Barra de Búsqueda y Filtros Reactivos -->
<div class="card border-0 shadow-sm rounded-4 mb-4 bg-white">
    <div class="card-body p-3 p-md-4">
        <div class="row g-3 align-items-end">
            <!-- 1. Buscador de Alimento / EAN -->
            <div class="col-lg-4 col-md-6">
                <label for="txtBuscar" class="form-label small fw-semibold text-secondary mb-1">
                    <i class="bi bi-search me-1"></i>Buscar alimento o código
                </label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0 text-muted rounded-start-3">
                        <i class="bi bi-upc-scan"></i>
                    </span>
                    <input type="text"
                           id="txtBuscar"
                           class="form-control bg-light border-start-0 rounded-end-3 ps-0"
                           placeholder="Escriba el nombre o código EAN..." />
                </div>
            </div>

            <!-- 2. Filtro de Categoría -->
            <div class="col-lg-3 col-md-6">
                <label for="cboCategoria" class="form-label small fw-semibold text-secondary mb-1">
                    <i class="bi bi-tag-fill me-1"></i>Categoría
                </label>
                <select id="cboCategoria" class="form-select rounded-3">
                    <option value="">Todas las categorías</option>
                    @if (ViewBag.Categorias != null)
                    {
                        foreach (var cat in (IEnumerable<string>)ViewBag.Categorias)
                        {
                            <option value="@cat">@cat</option>
                        }
                    }
                </select>
            </div>

            <!-- 3. Filtro de Estado de Stock -->
            <div class="col-lg-2 col-md-6">
                <label for="cboEstadoLote" class="form-label small fw-semibold text-secondary mb-1">
                    <i class="bi bi-layers-fill me-1"></i>Estado Stock
                </label>
                <select id="cboEstadoLote" class="form-select rounded-3">
                    <option value="">Todos</option>
                    <option value="disponible">Con stock suficiente</option>
                    <option value="reponer">Bajo stock mínimo</option>
                    <option value="sinstock">Agotado / Sin stock</option>
                </select>
            </div>

            <!-- 4. Filtro Semáforo FEFO -->
            <div class="col-lg-3 col-md-6">
                <label for="cboFefo" class="form-label small fw-semibold text-secondary mb-1">
                    <i class="bi bi-stopwatch-fill me-1"></i>Semáforo de Vencimiento
                </label>
                <select id="cboFefo" class="form-select rounded-3">
                    <option value="">Todos los estados FEFO</option>
                    <option value="optimo">🟢 Óptimo (> 15 días)</option>
                    <option value="atencion">🟡 Atención (≤ 15 días)</option>
                    <option value="urgente">🟠 Urgente (≤ 5 días)</option>
                    <option value="critico">🔴 Crítico / Vencido</option>
                </select>
            </div>
        </div>
    </div>
</div>

<!-- Tabla de Existencias y Control FEFO -->
<div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4 bg-white">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0" id="tablaStock">
            <thead class="table-light text-secondary text-uppercase small fw-semibold">
                <tr>
                    <th class="ps-4 py-3" style="min-width: 260px;">Alimento & Código EAN</th>
                    <th class="text-center" style="min-width: 170px;">Categoría</th>
                    <th class="text-center" style="min-width: 140px;">Stock Actual</th>
                    <th class="text-center" style="min-width: 120px;">Stock Mínimo</th>
                    <th class="text-center" style="min-width: 150px;">Próximo Vencimiento</th>
                    <th class="text-center" style="min-width: 150px;">Semáforo FEFO</th>
                    <th class="text-end pe-4" style="min-width: 180px;">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary opacity-50"></i>
                            No hay productos registrados con existencias en el depósito.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        var tieneVencimiento = item.ProximoVencimiento.HasValue;
                        var dias = tieneVencimiento ? (item.ProximoVencimiento!.Value.Date - DateTime.Today).Days : 999;
                        bool requiereReposicion = item.StockActual <= item.StockMinimo;

                        string estadoLoteVal = item.StockActual == 0 ? "sinstock" : (requiereReposicion ? "reponer" : "disponible");
                        string fefoVal = !tieneVencimiento ? "sinstock" : (dias <= 0 ? "critico" : (dias <= 5 ? "urgente" : (dias <= 15 ? "atencion" : "optimo")));

                        <tr class="fila-producto"
                            data-busqueda="@(item.NombreProducto.ToLower()) @(item.CodigoBarras.ToLower())"
                            data-categoria="@item.Categoria"
                            data-estado-lote="@estadoLoteVal"
                            data-fefo="@fefoVal">

                            <!-- Alimento con Avatar Inicial -->
                            <td class="ps-4 py-3">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="rounded-circle bg-success bg-opacity-10 text-success d-flex align-items-center justify-content-center fw-bold shadow-sm flex-shrink-0"
                                         style="width: 42px; height: 42px; font-size: 0.9rem;">
                                        @(item.NombreProducto.Length > 2 ? item.NombreProducto.Substring(0, 2).ToUpper() : "AL")
                                    </div>
                                    <div>
                                        <div class="fw-bold text-dark" style="font-size: 0.95rem;">@item.NombreProducto</div>
                                        <div class="mt-1">
                                            <span class="badge bg-light text-secondary border font-monospace px-2 py-1" style="font-size: 0.78rem;">
                                                <i class="bi bi-upc me-1"></i>@item.CodigoBarras
                                            </span>
                                            <span class="text-muted small ms-1" style="font-size: 0.75rem;">
                                                (@item.CantidadLotesActivos @(item.CantidadLotesActivos == 1 ? "lote" : "lotes"))
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </td>

                            <!-- Categoría con Badge Suave -->
                            <td class="text-center">
                                <span class="badge bg-light text-dark border rounded-pill px-3 py-2 fw-medium" style="font-size: 0.82rem;">
                                    <i class="bi bi-tag text-muted me-1"></i>@item.Categoria
                                </span>
                            </td>

                            <!-- Stock Actual & Alerta de Reposición -->
                            <td class="text-center">
                                <div class="fw-bold text-dark fs-6">
                                    @item.StockActual.ToString("N0") <span class="fw-normal text-secondary small">@item.UnidadMedida</span>
                                </div>
                                @if (requiereReposicion)
                                {
                                    <div class="mt-1">
                                        <span class="badge bg-danger bg-opacity-10 text-danger border border-danger-subtle rounded-pill px-2 py-1" style="font-size: 0.72rem;" title="Stock igual o inferior al mínimo configurado">
                                            <i class="bi bi-arrow-down-square-fill me-1"></i>Reponer
                                        </span>
                                    </div>
                                }
                            </td>

                            <!-- Stock Mínimo -->
                            <td class="text-center text-muted font-monospace" style="font-size: 0.88rem;">
                                @item.StockMinimo.ToString("N0") <span class="small">@item.UnidadMedida</span>
                            </td>

                            <!-- Próximo Vencimiento -->
                            <td class="text-center">
                                @if (tieneVencimiento)
                                {
                                    <span class="badge bg-light text-dark border font-monospace px-3 py-2" style="font-size: 0.85rem;">
                                        <i class="bi bi-calendar-event text-secondary me-1"></i>@item.ProximoVencimiento!.Value.ToString("dd/MM/yyyy")
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-light text-secondary border font-monospace px-3 py-2" style="font-size: 0.78rem;">
                                        Sin Lotes Aptos
                                    </span>
                                }
                            </td>

                            <!-- Semáforo FEFO con Badges Suaves Bootstrap -->
                            <td class="text-center">
                                @if (!tieneVencimiento || item.StockActual == 0)
                                {
                                    <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary-subtle rounded-pill px-3 py-2" style="font-size: 0.8rem;">
                                        <i class="bi bi-dash-circle me-1"></i>Sin Stock
                                    </span>
                                }
                                else if (dias <= 0)
                                {
                                    <span class="badge bg-danger bg-opacity-10 text-danger border border-danger-subtle rounded-pill px-3 py-2 fw-semibold" style="font-size: 0.8rem;">
                                        <i class="bi bi-x-circle-fill me-1"></i>Vencido
                                    </span>
                                }
                                else if (dias <= 5)
                                {
                                    <span class="badge rounded-pill px-3 py-2 fw-semibold" style="background-color: #fff1e6; color: #c2410c; border: 1px solid #fed7aa; font-size: 0.8rem;">
                                        <i class="bi bi-stopwatch-fill me-1"></i>Urgente (@dias d)
                                    </span>
                                }
                                else if (dias <= 15)
                                {
                                    <span class="badge bg-warning bg-opacity-10 text-warning-emphasis border border-warning-subtle rounded-pill px-3 py-2 fw-semibold" style="font-size: 0.8rem;">
                                        <i class="bi bi-exclamation-triangle-fill me-1"></i>Atención (@dias d)
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success border border-success-subtle rounded-pill px-3 py-2 fw-semibold" style="font-size: 0.8rem;">
                                        <i class="bi bi-check-circle-fill me-1"></i>Óptimo (@dias d)
                                    </span>
                                }
                            </td>

                            <!-- Acciones Rápidas -->
                            <td class="text-end pe-4 text-nowrap">
                                <div class="d-inline-flex align-items-center justify-content-end gap-2">
                                    <a asp-action="Historial" asp-route-productoId="@item.ProductoId" class="btn btn-sm btn-outline-primary rounded-pill px-3 fw-semibold shadow-none" title="Ver historial de movimientos y auditoría">
                                        <i class="bi bi-clock-history me-1"></i>Historial
                                    </a>

                                    @if (dias <= 0)
                                    {
                                        <a asp-action="RegistrarMerma" asp-route-productoId="@item.ProductoId" class="btn btn-sm btn-danger rounded-pill px-3 fw-semibold shadow-sm" title="Registrar baja por vencimiento inmediato">
                                            <i class="bi bi-trash-fill me-1"></i>Dar de baja
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
                <tr id="rowSinResultadosFiltro" class="d-none">
                    <td colspan="7" class="text-center py-5 text-muted">
                        <i class="bi bi-funnel fs-2 d-block mb-2 text-secondary opacity-50"></i>
                        No se encontraron alimentos que coincidan con los filtros seleccionados.
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<!-- Leyenda Informativa del Protocolo FEFO -->
<div class="card border-0 shadow-sm rounded-4 bg-white p-3 p-md-4 mb-4">
    <div class="d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-3">
        <div class="d-flex align-items-center gap-2">
            <span class="badge bg-success bg-opacity-10 text-success rounded-circle p-2">
                <i class="bi bi-arrow-repeat fs-5"></i>
            </span>
            <div>
                <span class="fw-bold text-dark d-block" style="font-size: 0.95rem;">Criterio Logístico FEFO (First Expired, First Out)</span>
                <small class="text-muted">El sistema prioriza automáticamente la extracción de los lotes aptos con fecha de caducidad más cercana.</small>
            </div>
        </div>

        <div class="d-flex flex-wrap align-items-center gap-2">
            <span class="badge bg-success bg-opacity-10 text-success border border-success-subtle rounded-pill px-3 py-2">
                <i class="bi bi-check-circle-fill me-1"></i>Óptimo (&gt; 15 días)
            </span>
            <span class="badge bg-warning bg-opacity-10 text-warning-emphasis border border-warning-subtle rounded-pill px-3 py-2">
                <i class="bi bi-exclamation-triangle-fill me-1"></i>Atención (≤ 15 días)
            </span>
            <span class="badge rounded-pill px-3 py-2" style="background-color: #fff1e6; color: #c2410c; border: 1px solid #fed7aa;">
                <i class="bi bi-stopwatch-fill me-1"></i>Urgente (≤ 5 días)
            </span>
            <span class="badge bg-danger bg-opacity-10 text-danger border border-danger-subtle rounded-pill px-3 py-2">
                <i class="bi bi-x-circle-fill me-1"></i>Crítico (Vencido)
            </span>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const txtBuscar = document.getElementById('txtBuscar');
            const cboCategoria = document.getElementById('cboCategoria');
            const cboEstadoLote = document.getElementById('cboEstadoLote');
            const cboFefo = document.getElementById('cboFefo');
            const filas = document.querySelectorAll('.fila-producto');
            const rowSinResultados = document.getElementById('rowSinResultadosFiltro');

            function filtrarTabla() {
                const busqueda = txtBuscar.value.toLowerCase().trim();
                const categoria = cboCategoria.value;
                const estadoLote = cboEstadoLote.value;
                const fefo = cboFefo.value;

                let visibles = 0;

                filas.forEach(fila => {
                    const matchBusqueda = !busqueda || fila.dataset.busqueda.includes(busqueda);
                    const matchCategoria = !categoria || fila.dataset.categoria === categoria;
                    const matchEstadoLote = !estadoLote || fila.dataset.estadoLote === estadoLote;
                    const matchFefo = !fefo || fila.dataset.fefo === fefo;

                    if (matchBusqueda && matchCategoria && matchEstadoLote && matchFefo) {
                        fila.style.display = '';
                        visibles++;
                    } else {
                        fila.style.display = 'none';
                    }
                });

                if (rowSinResultados) {
                    if (visibles === 0 && filas.length > 0) {
                        rowSinResultados.classList.remove('d-none');
                    } else {
                        rowSinResultados.classList.add('d-none');
                    }
                }
            }

            txtBuscar.addEventListener('input', filtrarTabla);
            cboCategoria.addEventListener('change', filtrarTabla);
            cboEstadoLote.addEventListener('change', filtrarTabla);
            cboFefo.addEventListener('change', filtrarTabla);
        });
    </script>
}