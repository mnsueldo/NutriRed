@model IEnumerable<NutriRed.Domain.Entities.MovimientoStock>
@using NutriRed.Domain.Enums
@{
    var producto = ViewBag.Producto as NutriRed.Domain.Entities.Producto;
    ViewData["Title"] = $"Historial de Movimientos - {producto?.Nombre}";

    var totalMovimientos = Model.Count();
    var stockActual = producto?.Lotes?
        .Where(l => l.Estado == EstadoLote.Disponible && l.FechaVencimiento > DateTime.Today)
        .Sum(l => l.CantidadDisponible) ?? 0;
    var stockMinimo = producto?.StockMinimo ?? 0;
    bool bajoStock = stockActual <= stockMinimo;
}

<!-- Navegación Breadcrumb -->
<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb mb-0">
        <li class="breadcrumb-item">
            <a asp-action="Index" class="text-decoration-none text-muted">
                <i class="bi bi-boxes me-1"></i>Stock de Alimentos
            </a>
        </li>
        <li class="breadcrumb-item active text-dark fw-semibold" aria-current="page">
            Historial de Movimientos
        </li>
    </ol>
</nav>

<!-- Hero Panel / Ficha Resumen del Alimento -->
<div class="card border-0 shadow-sm rounded-4 mb-4 bg-white overflow-hidden">
    <div class="card-body p-4">
        <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-4">
            
            <!-- Identidad del Producto -->
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-circle bg-primary bg-opacity-10 text-primary d-flex align-items-center justify-content-center fw-bold shadow-sm flex-shrink-0"
                     style="width: 64px; height: 64px; font-size: 1.4rem;">
                    <i class="bi bi-box-seam"></i>
                </div>
                <div>
                    <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                        <h2 class="h4 fw-bold text-dark mb-0">@producto?.Nombre</h2>
                        @if (bajoStock)
                        {
                            <span class="badge bg-danger bg-opacity-10 text-danger border border-danger-subtle rounded-pill px-3 py-1 fw-semibold" style="font-size: 0.75rem;">
                                <i class="bi bi-exclamation-triangle-fill me-1"></i>Stock Crítico
                            </span>
                        }
                    </div>
                    <div class="d-flex flex-wrap align-items-center gap-2">
                        <span class="badge bg-light text-dark border rounded-pill px-3 py-1 font-monospace" style="font-size: 0.8rem;">
                            <i class="bi bi-upc me-1 text-muted"></i>@producto?.CodigoBarras
                        </span>
                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1" style="font-size: 0.8rem;">
                            <i class="bi bi-tag-fill me-1"></i>@(producto?.Categoria?.Nombre ?? "Sin Categoría")
                        </span>
                        <span class="badge bg-light text-secondary border rounded-pill px-3 py-1" style="font-size: 0.8rem;">
                            Unidad: @producto?.UnidadMedida
                        </span>
                    </div>
                </div>
            </div>

            <!-- KPIs Rápidos del Producto & Acciones -->
            <div class="d-flex flex-wrap align-items-center gap-3">
                <!-- Mini KPI: Stock Actual -->
                <div class="bg-light rounded-4 px-4 py-2 border text-center">
                    <span class="text-muted small fw-semibold text-uppercase d-block" style="font-size: 0.7rem;">Stock Disponible</span>
                    <span class="fs-4 fw-bold @(bajoStock ? "text-danger" : "text-success")">
                        @stockActual.ToString("N0") <small class="fs-6 fw-normal text-muted">@producto?.UnidadMedida</small>
                    </span>
                </div>

                <!-- Mini KPI: Stock Mínimo -->
                <div class="bg-light rounded-4 px-4 py-2 border text-center">
                    <span class="text-muted small fw-semibold text-uppercase d-block" style="font-size: 0.7rem;">Stock Mínimo</span>
                    <span class="fs-4 fw-bold text-secondary">
                        @stockMinimo.ToString("N0") <small class="fs-6 fw-normal text-muted">@producto?.UnidadMedida</small>
                    </span>
                </div>

                <!-- Acciones Rápidas -->
                <div class="d-flex flex-column gap-2">
                    <a asp-action="RegistrarMerma" asp-route-productoId="@producto?.Id" class="btn btn-outline-danger rounded-pill fw-semibold shadow-sm px-3 py-2 btn-sm">
                        <i class="bi bi-trash3-fill me-1"></i> Registrar Merma
                    </a>
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill fw-semibold px-3 py-2 btn-sm">
                        <i class="bi bi-arrow-left me-1"></i> Volver a Stock
                    </a>
                </div>

            </div>
        </div>
    </div>
</div>

<!-- Tabla Auditable de Movimientos (Historial) -->
<div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white mb-4">
    <div class="card-header bg-white py-3 px-4 border-bottom d-flex justify-content-between align-items-center">
        <div>
            <h5 class="fw-bold text-dark mb-0">
                <i class="bi bi-clock-history text-primary me-2"></i>Historial Cronológico de Movimientos
            </h5>
            <small class="text-muted">Trazabilidad inmutable de donaciones recibidas, asignaciones a kits y mermas por rotura o vencimiento.</small>
        </div>
        <span class="badge bg-primary bg-opacity-10 text-primary border border-primary-subtle rounded-pill px-3 py-2 fw-semibold">
            @totalMovimientos movimientos auditados
        </span>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light text-secondary text-uppercase small fw-semibold">
                <tr>
                    <th class="ps-4 py-3" style="min-width: 160px;">Fecha & Hora</th>
                    <th class="text-center" style="min-width: 140px;">Lote Físico</th>
                    <th class="text-center" style="min-width: 150px;">Tipo de Movimiento</th>
                    <th class="text-center" style="min-width: 140px;">Motivo</th>
                    <th class="text-end" style="min-width: 130px;">Variación</th>
                    <th style="min-width: 160px;">Usuario Responsable</th>
                    <th class="pe-4" style="min-width: 220px;">Observaciones</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary opacity-50"></i>
                            No hay movimientos registrados para este alimento.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var m in Model)
                    {
                        bool esIngreso = m.TipoMovimiento == TipoMovimiento.IngresoDonacion || (m.TipoMovimiento == TipoMovimiento.AjusteManual && m.Cantidad > 0);
                        bool esBaja = m.TipoMovimiento == TipoMovimiento.BajaPorMerma;
                        bool esEgreso = m.TipoMovimiento == TipoMovimiento.EgresoPaquete;

                        string badgeTipoClass = esIngreso 
                            ? "bg-success bg-opacity-10 text-success border border-success-subtle" 
                            : (esBaja 
                                ? "bg-danger bg-opacity-10 text-danger border border-danger-subtle" 
                                : (esEgreso 
                                    ? "bg-primary bg-opacity-10 text-primary border border-primary-subtle" 
                                    : "bg-secondary bg-opacity-10 text-secondary border border-secondary-subtle"));

                        string signo = esIngreso ? "+" : "-";

                        <tr>
                            <!-- Fecha y Hora -->
                            <td class="ps-4 font-monospace text-muted" style="font-size: 0.85rem;">
                                <i class="bi bi-calendar3 me-1 text-secondary"></i>@m.Fecha.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                            </td>

                            <!-- Lote -->
                            <td class="text-center">
                                <span class="badge bg-light text-primary border font-monospace px-3 py-2 fw-bold" style="font-size: 0.85rem;">
                                    <i class="bi bi-box me-1"></i>@(m.Lote?.NumeroLote ?? "S/N")
                                </span>
                            </td>

                            <!-- Tipo de Movimiento -->
                            <td class="text-center">
                                <span class="badge rounded-pill px-3 py-2 fw-semibold @badgeTipoClass" style="font-size: 0.8rem;">
                                    @if (esIngreso)
                                    {
                                        <i class="bi bi-arrow-down-left me-1"></i>
                                    }
                                    else if (esBaja)
                                    {
                                        <i class="bi bi-trash3 me-1"></i>
                                    }
                                    else
                                    {
                                        <i class="bi bi-arrow-up-right me-1"></i>
                                    }
                                    @m.TipoMovimiento
                                </span>
                            </td>

                            <!-- Motivo -->
                            <td class="text-center">
                                <span class="badge bg-light text-dark border rounded-pill px-3 py-1 font-monospace" style="font-size: 0.78rem;">
                                    @m.Motivo
                                </span>
                            </td>

                            <!-- Cantidad con Signo y Color -->
                            <td class="text-end fw-bold font-monospace fs-6 @(esIngreso ? "text-success" : "text-danger")">
                                @signo@m.Cantidad.ToString("N1") <span class="small fw-normal text-secondary">@producto?.UnidadMedida</span>
                            </td>

                            <!-- Usuario Responsable -->
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="rounded-circle bg-secondary bg-opacity-10 text-secondary d-flex align-items-center justify-content-center" style="width: 28px; height: 28px; font-size: 0.8rem;">
                                        <i class="bi bi-person-fill"></i>
                                    </div>
                                    <span class="small fw-medium text-dark text-truncate" style="max-width: 140px;">
                                        @(string.IsNullOrWhiteSpace(m.UsuarioId) ? "Sistema" : m.UsuarioId)
                                    </span>
                                </div>
                            </td>

                            <!-- Observaciones -->
                            <td class="pe-4">
                                <small class="text-secondary d-block text-truncate" style="max-width: 260px;" title="@m.Observaciones">
                                    @(string.IsNullOrWhiteSpace(m.Observaciones) ? "Sin observaciones" : m.Observaciones)
                                </small>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>