@model NutriRed.Domain.Entities.FamiliaBeneficiaria

@{
    ViewData["Title"] = "Alta de Familia Beneficiaria";
    Layout = "_Layout";
}

<div class="row justify-content-center py-4">
    <div class="col-12 col-md-10 col-lg-8">
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
            <!-- Cabecera con Gradiente Verde -->
            <div class="card-header bg-success bg-gradient text-white p-4 border-0">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-circle bg-white bg-opacity-25 p-3 d-flex align-items-center justify-content-center" style="width: 58px; height: 58px;">
                        <i class="bi bi-person-plus-fill fs-2 text-white"></i>
                    </div>
                    <div>
                        <h3 class="fw-bold mb-0">Alta de Legajo Familiar</h3>
                        <p class="mb-0 text-white-50 small">Registrar un nuevo hogar beneficiario en el padrón asistencial de NutriRed</p>
                    </div>
                </div>
            </div>

            <div class="card-body p-4 p-md-5">
                <form asp-action="Create" method="post" id="formCrearFamilia">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 small py-2 px-3 mb-4" role="alert"></div>

                    <!-- SECCIÓN 1: DATOS DEL TITULAR -->
                    <div class="d-flex align-items-center gap-2 border-bottom pb-2 mb-3">
                        <i class="bi bi-person-vcard text-success fs-5"></i>
                        <h5 class="fw-bold text-dark mb-0">Datos del Titular Responsable</h5>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="NombreTitular" class="form-label fw-semibold text-secondary">Nombre del Titular</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted"><i class="bi bi-person"></i></span>
                                <input asp-for="NombreTitular" class="form-control" placeholder="Ej: Mario Alberto" autofocus />
                            </div>
                            <span asp-validation-for="NombreTitular" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ApellidoTitular" class="form-label fw-semibold text-secondary">Apellido del Titular</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted"><i class="bi bi-person-badge"></i></span>
                                <input asp-for="ApellidoTitular" class="form-control" placeholder="Ej: González" />
                            </div>
                            <span asp-validation-for="ApellidoTitular" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="DniTitular" class="form-label fw-semibold text-secondary">DNI del Titular</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted"><i class="bi bi-card-heading"></i></span>
                                <input asp-for="DniTitular" class="form-control font-monospace" placeholder="Ej: 28456789" />
                            </div>
                            <span asp-validation-for="DniTitular" class="text-danger small"></span>
                            <small class="text-muted" style="font-size: 0.75rem;">Ingrese el documento sin puntos ni caracteres especiales.</small>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="CantidadIntegrantes" class="form-label fw-semibold text-secondary">Cantidad de Integrantes</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted"><i class="bi bi-people"></i></span>
                                <input asp-for="CantidadIntegrantes" class="form-control" type="number" min="1" max="25" value="1" id="inputIntegrantes" />
                            </div>
                            <span asp-validation-for="CantidadIntegrantes" class="text-danger small"></span>
                            <small class="text-muted" style="font-size: 0.75rem;">Total de personas convivientes en el hogar.</small>
                        </div>
                    </div>

                    <!-- Tarjeta Informativa de Asignación de Kit Asistencial -->
                    <div class="card border-0 bg-success bg-opacity-10 rounded-4 p-3 mb-4">
                        <div class="d-flex align-items-center gap-3">
                            <i class="bi bi-box-seam-fill text-success fs-3"></i>
                            <div>
                                <span class="fw-bold text-success d-block">Asignación Automática de Kit Nutricional</span>
                                <small class="text-secondary" id="txtKitAsignado">
                                    Con <strong id="lblCantIntegrantes">1</strong> integrante(s), el sistema sugerirá por defecto el <strong>Kit Nutricional Básico (1 a 3 integrantes)</strong>.
                                </small>
                            </div>
                        </div>
                    </div>

                    <!-- SECCIÓN 2: CONTACTO Y DOMICILIO -->
                    <div class="d-flex align-items-center gap-2 border-bottom pb-2 mb-3">
                        <i class="bi bi-geo-alt text-success fs-5"></i>
                        <h5 class="fw-bold text-dark mb-0">Contacto y Localización</h5>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="Telefono" class="form-label fw-semibold text-secondary">Teléfono de Contacto</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted"><i class="bi bi-telephone"></i></span>
                                <input asp-for="Telefono" class="form-control" placeholder="Ej: 11-4567-8901" />
                            </div>
                            <span asp-validation-for="Telefono" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-secondary">Estado Inicial</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-success"><i class="bi bi-shield-check"></i></span>
                                <input type="text" class="form-control bg-light text-success fw-semibold" value="Activo (Habilitado para retiro)" readonly />
                            </div>
                            <small class="text-muted" style="font-size: 0.75rem;">Los nuevos legajos se dan de alta en estado activo.</small>
                        </div>

                        <div class="col-12">
                            <label asp-for="Direccion" class="form-label fw-semibold text-secondary">Domicilio / Dirección del Hogar</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted"><i class="bi bi-geo-alt"></i></span>
                                <input asp-for="Direccion" class="form-control" placeholder="Ej: Calle 14 nro 543, Barrio Esperanza" />
                            </div>
                            <span asp-validation-for="Direccion" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- BOTONES DE ACCIÓN -->
                    <div class="d-flex justify-content-end align-items-center gap-2 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-light rounded-pill px-4 border">
                            <i class="bi bi-arrow-left me-1"></i> Cancelar
                        </a>
                        <button type="submit" class="btn btn-success rounded-pill px-5 shadow-sm fw-semibold">
                            <i class="bi bi-check-circle me-1"></i> Guardar Legajo Familiar
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const inputIntegrantes = document.getElementById('inputIntegrantes');
            const lblCant = document.getElementById('lblCantIntegrantes');
            const txtKit = document.getElementById('txtKitAsignado');

            function actualizarSugerencia() {
                const cant = parseInt(inputIntegrantes.value) || 1;
                lblCant.textContent = cant;

                if (cant <= 3) {
                    txtKit.innerHTML = `Con <strong>${cant}</strong> integrante(s), el sistema sugerirá por defecto el <strong class="text-success">Kit Nutricional Básico (1 a 3 integrantes)</strong>.`;
                } else {
                    txtKit.innerHTML = `Con <strong>${cant}</strong> integrante(s), el sistema sugerirá por defecto el <strong class="text-success">Kit Nutricional Familiar (4 o más integrantes)</strong>.`;
                }
            }

            inputIntegrantes.addEventListener('input', actualizarSugerencia);
            actualizarSugerencia();
        });
    </script>
}