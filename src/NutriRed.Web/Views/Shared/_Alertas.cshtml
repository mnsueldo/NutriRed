@*
    Vista Parcial: _Alertas.cshtml
    Muestra mensajes flash de notificación (Éxito, Error, Advertencia, Info) provenientes de TempData.
    Al leer cada mensaje, se remueve inmediatamente de TempData para evitar duplicación.
*@

@if (TempData["Exito"] != null || TempData["Success"] != null)
{
    var mensaje = TempData["Exito"] ?? TempData["Success"];
    TempData.Remove("Exito");
    TempData.Remove("Success");
    <div class="alert alert-success alert-dismissible fade show shadow-sm border-start border-4 border-success d-flex align-items-center mb-4" role="alert">
        <i class="bi bi-check-circle-fill fs-4 me-3 text-success"></i>
        <div>
            <strong>¡Operación Exitosa!</strong>
            <div>@mensaje</div>
        </div>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

@if (TempData["Error"] != null || TempData["ErrorMensaje"] != null)
{
    var mensaje = TempData["Error"] ?? TempData["ErrorMensaje"];
    TempData.Remove("Error");
    TempData.Remove("ErrorMensaje");
    <div class="alert alert-danger alert-dismissible fade show shadow-sm border-start border-4 border-danger d-flex align-items-center mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill fs-4 me-3 text-danger"></i>
        <div>
            <strong>Atención / Error</strong>
            <div>@mensaje</div>
        </div>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

@if (TempData["Advertencia"] != null || TempData["Warning"] != null)
{
    var mensaje = TempData["Advertencia"] ?? TempData["Warning"];
    TempData.Remove("Advertencia");
    TempData.Remove("Warning");
    <div class="alert alert-warning alert-dismissible fade show shadow-sm border-start border-4 border-warning d-flex align-items-center mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill fs-4 me-3 text-warning"></i>
        <div>
            <strong>Advertencia de Operación</strong>
            <div>@mensaje</div>
        </div>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

@if (TempData["Info"] != null)
{
    var mensaje = TempData["Info"];
    TempData.Remove("Info");
    <div class="alert alert-info alert-dismissible fade show shadow-sm border-start border-4 border-info d-flex align-items-center mb-4" role="alert">
        <i class="bi bi-info-circle-fill fs-4 me-3 text-info"></i>
        <div>
            <strong>Información</strong>
            <div>@mensaje</div>
        </div>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

