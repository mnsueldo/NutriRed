@model IEnumerable<Categoria>

@{
    ViewData["Title"] = "Categorías de Alimentos";
    bool verTodas = ViewBag.VerTodas == true;

    // Métricas de resumen
    var totalCategorias = Model.Count();
    var categoriasActivas = Model.Count(c => c.Activo);
    var categoriasInactivas = Model.Count(c => !c.Activo);
}

<!-- Encabezado Principal -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1 small">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none text-muted">Inicio</a></li>
                <li class="breadcrumb-item text-muted">Almacén</li>
                <li class="breadcrumb-item active text-dark fw-semibold" aria-current="page">Categorías</li>
            </ol>
        </nav>
        <h2 class="fw-bold mb-1 text-dark">
            <i class="bi bi-tags-fill text-success me-2"></i>Categorías de Alimentos
        </h2>
        <p class="text-secondary mb-0">Clasificación nutricional y de almacenamiento para donaciones, kits y control de stock.</p>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-success rounded-pill shadow-sm px-4 py-2 fw-semibold">
            <i class="bi bi-plus-circle-fill me-2"></i>Nueva Categoría
        </a>
    </div>
</div>

<!-- Panel de Métricas / KPIs Rápidos -->
<div class="row g-3 mb-4">
    <!-- 1. Total Categorías -->
    <div class="col-12 col-sm-4">
        <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-circle bg-success bg-opacity-10 p-3 text-success d-flex align-items-center justify-content-center" style="width: 52px; height: 52px;">
                    <i class="bi bi-tags-fill fs-4"></i>
                </div>
                <div>
                    <span class="text-muted small fw-semibold text-uppercase d-block">Total Categorías</span>
                    <span class="fs-4 fw-bold text-dark">@totalCategorias</span>
                    <small class="text-muted d-block" style="font-size: 0.72rem;">Grupos en el sistema</small>
                </div>
            </div>
        </div>
    </div>

    <!-- 2. Categorías Activas -->
    <div class="col-12 col-sm-4">
        <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-circle bg-emerald bg-opacity-10 p-3 text-emerald d-flex align-items-center justify-content-center" style="width: 52px; height: 52px; background-color: rgba(5, 150, 105, 0.1); color: #059669;">
                    <i class="bi bi-check-circle-fill fs-4"></i>
                </div>
                <div>
                    <span class="text-muted small fw-semibold text-uppercase d-block">Categorías Activas</span>
                    <span class="fs-4 fw-bold text-success">@categoriasActivas</span>
                    <small class="text-muted d-block" style="font-size: 0.72rem;">Disponibles para catálogo</small>
                </div>
            </div>
        </div>
    </div>

    <!-- 3. Categorías Inactivas -->
    <div class="col-12 col-sm-4">
        <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-circle bg-secondary bg-opacity-10 p-3 text-secondary d-flex align-items-center justify-content-center" style="width: 52px; height: 52px;">
                    <i class="bi bi-slash-circle-fill fs-4"></i>
                </div>
                <div>
                    <span class="text-muted small fw-semibold text-uppercase d-block">Inactivas</span>
                    <span class="fs-4 fw-bold text-secondary">@categoriasInactivas</span>
                    <small class="text-muted d-block" style="font-size: 0.72rem;">Bloqueadas para nuevos items</small>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Filtros de Visualización Segmentados -->
<div class="card border-0 shadow-sm rounded-4 mb-4 bg-white">
    <div class="card-body p-3 px-4 d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3">
        <div class="btn-group p-1 bg-light rounded-pill border" role="group" aria-label="Filtro de estados">
            <a asp-action="Index" asp-route-verTodas="false" 
               class="btn btn-sm rounded-pill px-3 fw-semibold @(!verTodas ? "btn-success shadow-sm" : "btn-light text-secondary border-0")">
                <i class="bi bi-check2-circle me-1"></i> Solo Activas
            </a>
            <a asp-action="Index" asp-route-verTodas="true" 
               class="btn btn-sm rounded-pill px-3 fw-semibold @(verTodas ? "btn-success shadow-sm" : "btn-light text-secondary border-0")">
                <i class="bi bi-collection me-1"></i> Ver Todas
            </a>
        </div>
        <span class="text-muted small">
            Total de registros listados: <strong>@totalCategorias</strong>
        </span>
    </div>
</div>

<!-- Grilla de Categorías -->
<div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <div class="rounded-circle bg-light d-inline-flex p-4 mb-3 text-muted">
                <i class="bi bi-tags" style="font-size: 3rem;"></i>
            </div>
            <h4 class="h5 fw-bold text-dark">No hay categorías para mostrar</h4>
            <p class="text-secondary small mb-3">No se encontraron registros con el filtro seleccionado.</p>
            <a asp-action="Create" class="btn btn-success rounded-pill px-4 fw-semibold shadow-sm">
                <i class="bi bi-plus-circle-fill me-2"></i> Registrar la primera categoría
            </a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-secondary text-uppercase small fw-bold">
                    <tr>
                        <th style="width: 90px;" class="ps-4"># ID</th>
                        <th>Nombre de la Categoría</th>
                        <th>Descripción</th>
                        <th style="width: 140px;" class="text-center">Estado</th>
                        <th style="width: 190px;" class="text-end pe-4">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var cat in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                <span class="code-tag rounded-3 font-mono">#@cat.Id</span>
                            </td>
                            <td>
                                <div class="d-flex align-items-center gap-3">
                                    <div class="rounded-3 bg-success bg-opacity-10 text-success p-2 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                        <i class="bi bi-tag-fill fs-5"></i>
                                    </div>
                                    <span class="fw-bold text-dark">@cat.Nombre</span>
                                </div>
                            </td>
                            <td>
                                <span class="text-secondary small">
                                    @(string.IsNullOrWhiteSpace(cat.Descripcion) ? "Sin descripción detallada" : cat.Descripcion)
                                </span>
                            </td>
                            <td class="text-center">
                                @if (cat.Activo)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1">
                                        <i class="bi bi-check-circle-fill me-1"></i> Activo
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle rounded-pill px-3 py-1">
                                        <i class="bi bi-slash-circle me-1"></i> Inactivo
                                    </span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                <div class="d-inline-flex gap-1">
                                    <!-- Editar -->
                                    <a asp-action="Edit" asp-route-id="@cat.Id" class="btn btn-sm btn-outline-secondary rounded-3" title="Editar categoría">
                                        <i class="bi bi-pencil me-1"></i> Editar
                                    </a>

                                    <!-- Alternar Activo / Desactivado -->
                                    <form asp-action="CambiarEstado" method="post" class="d-inline"
                                          onsubmit="return confirm('¿Está seguro de que desea @(cat.Activo ? "desactivar" : "activar") la categoría \'@cat.Nombre\'?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@cat.Id" />
                                        <input type="hidden" name="nuevoEstado" value="@(!cat.Activo ? "true" : "false")" />
                                        <button type="submit" class="btn btn-sm @(cat.Activo ? "btn-outline-danger" : "btn-outline-success") rounded-3"
                                                title="@(cat.Activo ? "Desactivar categoría" : "Activar categoría")">
                                            <i class="bi @(cat.Activo ? "bi-toggle-on text-danger" : "bi-toggle-off text-success") me-1"></i>
                                            @(cat.Activo ? "Baja" : "Alta")
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="card-footer bg-white border-top p-3 px-4 d-flex justify-content-between align-items-center">
            <small class="text-muted">Total de categorías: <strong>@Model.Count()</strong></small>
            <small class="text-muted"><i class="bi bi-shield-check me-1 text-success"></i> La baja lógica preserva la integridad del historial de alimentos.</small>
        </div>
    }
</div>
