@model Categoria

@{
    ViewData["Title"] = "Nueva Categoría";
}

<div class="row justify-content-center">
    <div class="col-lg-8 col-xl-7">
        <!-- Navegación de Migas de Pan -->
        <nav aria-label="breadcrumb" class="mb-3">
            <ol class="breadcrumb mb-1 small">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none text-muted">Inicio</a></li>
                <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none text-muted">Categorías</a></li>
                <li class="breadcrumb-item active text-dark fw-semibold" aria-current="page">Alta de Categoría</li>
            </ol>
        </nav>

        <div class="card card-nr shadow-sm">
            <div class="card-header card-nr-header d-flex align-items-center gap-2">
                <div class="p-2 rounded-2" style="background: var(--nr-emerald-light); color: var(--nr-emerald-primary);">
                    <i class="bi bi-tag-fill fs-5"></i>
                </div>
                <div>
                    <h1 class="h5 fw-bold text-dark mb-0">Registrar Nueva Categoría</h1>
                    <small class="text-muted">Complete los datos para incorporar una nueva familia taxonómica de alimentos.</small>
                </div>
            </div>

            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" role="alert"></div>

                    <!-- Nombre de la Categoría -->
                    <div class="mb-3">
                        <label asp-for="Nombre" class="form-label fw-semibold text-dark">
                            Nombre de la Categoría <span class="text-danger">*</span>
                        </label>
                        <input asp-for="Nombre" class="form-control" placeholder="Ej: Lácteos, Legumbres, Pastas Secas..." autofocus />
                        <span asp-validation-for="Nombre" class="text-danger small"></span>
                        <div class="form-text">Debe ser un nombre descriptivo y no puede estar duplicado en el catálogo.</div>
                    </div>

                    <!-- Descripción -->
                    <div class="mb-4">
                        <label asp-for="Descripcion" class="form-label fw-semibold text-dark">
                            Descripción / Observaciones
                        </label>
                        <textarea asp-for="Descripcion" class="form-control" rows="3" 
                                  placeholder="Detalle los tipos de productos que abarca esta categoría (opcional)..."></textarea>
                        <span asp-validation-for="Descripcion" class="text-danger small"></span>
                    </div>

                    <!-- Estado Activo -->
                    <div class="form-check form-switch mb-4 p-3 bg-light rounded-3 border">
                        <input asp-for="Activo" class="form-check-input ms-0 me-3" type="checkbox" role="switch" id="switchActivo" checked />
                        <label class="form-check-label fw-semibold text-dark" for="switchActivo">
                            Habilitar categoría de forma inmediata
                        </label>
                        <div class="text-muted small">Solo las categorías activas estarán disponibles para asociar a nuevos alimentos en el catálogo.</div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-1"></i> Volver al Listado
                        </a>
                        <button type="submit" class="btn btn-emerald">
                            <i class="bi bi-check2-circle me-1"></i> Guardar Categoría
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
